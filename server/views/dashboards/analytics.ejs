<% const q = (typeof token !== 'undefined' && token) ? '?token=' + token : ''; %>
<% const body = `
<div class="cards">
  <div class="card"><div class="num">${pie.total_students}</div><div class="lbl">Mahasiswa Terdata</div></div>
  <div class="card"><div class="num">${pie.distribution.length}</div><div class="lbl">Skill Terpetakan</div></div>
  <div class="card"><div class="num">${line.top_skills.length ? line.top_skills[0].skill : '-'}</div><div class="lbl">Skill Terlaris (${line.period})</div></div>
</div>
<section class="panel">
  <h3>Distribusi Skill Mahasiswa (pie-data)</h3>
  <table><tr><th>Skill</th><th>Kategori</th><th>Mahasiswa</th><th>Rata-rata Level</th><th>Share</th></tr>
  ${pie.distribution.slice(0, 15).map(s => {
    const pct = pie.total_students ? Math.round(s.students / pie.total_students * 100) : 0;
    return `<tr><td>${s.name}</td><td>${s.category}</td><td>${s.students}</td><td>${s.avg_level}</td>
      <td style="min-width:140px"><div class="bar"><div style="width:${pct}%"></div></div><span class="muted">${pct}%</span></td></tr>`;
  }).join('') || '<tr><td colspan="5" class="muted">Belum ada data skill.</td></tr>'}
  </table>
</section>
<section class="panel">
  <h3>Tren Industri — Skill Dicari per Bulan (line-data)</h3>
  <table><tr><th>Bulan</th><th>Skill</th><th>Project</th></tr>
  ${line.trend.slice(0, 20).map(t => `<tr><td>${t.month}</td><td>${t.skill}</td><td>${t.c}</td></tr>`).join('') || '<tr><td colspan="3" class="muted">Belum ada data tren.</td></tr>'}
  </table>
</section>
<section class="panel">
  <h3>Heatmap Gap per Program Studi</h3>
  <table><tr><th>Prodi (n)</th>${heat.skills.map(s => `<th>${s}</th>`).join('')}</tr>
  ${heat.matrix.map(r => `<tr><td>${r.program_studi} (${r.students})</td>${heat.skills.map(s => {
    const v = r.gaps[s] || 0;
    const bg = v === 0 ? '#dcfce7' : v <= 20 ? '#e0f2fe' : v <= 40 ? '#fef3c7' : '#fee2e2';
    return `<td style="background:${bg}">${v}</td>`;
  }).join('')}</tr>`).join('') || `<tr><td colspan="${heat.skills.length + 1}" class="muted">Belum ada data.</td></tr>`}
  </table>
  <p class="muted">Legenda: hijau 0 (no gap) · biru ≤20 · kuning ≤40 · merah &gt;40.</p>
</section>
<p class="noprint">
  <a class="btn" href="/api/v1/analytics/export?format=csv${(typeof token !== 'undefined' && token) ? '&token=' + token : ''}">Export CSV</a>
  <button class="btn secondary" onclick="window.print()">Cetak / PDF</button>
</p>
`; %>
<%- include('../layout', { title: title, user: user, token: (typeof token !== 'undefined' ? token : ''), body: body }) %>
