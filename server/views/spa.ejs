<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Campus Industry Talent Hub</title>
  <!-- TASK-114: landing dipoles — sticky nav, hero gradient, fitur, langkah,
       peran, CTA. "/" landing only; masuk via "/app" (SPA) atau "/login" (EJS). -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script crossorigin src="https://unpkg.com/react@18.2.0/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18.2.0/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone@7.23.5/babel.min.js"></script>
</head>
<body class="bg-slate-950">
  <div id="root">
    <div class="min-h-screen flex items-center justify-center text-slate-400">Memuat aplikasi…</div>
  </div>
  <noscript>
    <div class="min-h-screen flex items-center justify-center text-slate-200">
      Aktifkan JavaScript, atau buka <a class="underline" href="/login">/login</a>.
    </div>
  </noscript>
  <script type="text/babel" data-presets="react">
    const ROLES = [
      { name: 'Mahasiswa', desc: 'Isi skill, daftar project, lihat gap & rekomendasi kursus.' },
      { name: 'Perusahaan', desc: 'Buat project, lihat kandidat terurut match score, beri evaluasi.' },
      { name: 'Kampus', desc: 'Pantau total mahasiswa, tren skill industri, dan heatmap gap.' },
      { name: 'Dosen', desc: 'Lihat antrian penilaian, isi evaluasi, pantau analytics.' },
    ];

    const STEPS = [
      { n: '1', t: 'Mahasiswa mengisi skill', d: 'Pilih dari taxonomy 31 skill + level 0–100 dan sumber (course/certification/experience).' },
      { n: '2', t: 'Perusahaan membuat project', d: 'Tentukan skill requirement + level; hanya perusahaan terverifikasi.' },
      { n: '3', t: 'Matching otomatis', d: 'Skor rule-based 50/20/10/10/10, kandidat terurut, gap & rekomendasi kursus muncul otomatis.' },
    ];

    const FEATURES = [
      { t: 'Project Marketplace', d: 'Cari, filter, dan daftar project industri langsung dari dashboard.' },
      { t: 'Talent Matching Transparan', d: 'Skor 0–100 dengan breakdown per skill: kuat, close, lemah.' },
      { t: 'Skill Gap Analysis', d: 'Selisih requirement vs level per skill + klasifikasi small–critical.' },
      { t: 'Rekomendasi Belajar', d: 'Course, workshop, sertifikasi, dan mentor — plus progress tracking.' },
      { t: 'Assessment 360°', d: 'Evaluasi skill, komunikasi, ketepatan; level skill ikut terupdate.' },
      { t: 'Analytics Kampus', d: 'Distribusi skill, tren industri, heatmap gap, export CSV.' },
    ];

    const LANDING_I18N = {
      id: {
        nav_fitur: 'Fitur', nav_cara: 'Cara Kerja', nav_daftar: 'Daftar', nav_masuk: 'Masuk', nav_buka: 'Buka Aplikasi',
        hero_badge: 'MVP · Kampus × Industri', hero_title1: 'Jembatan Kampus', hero_title2: 'Industri',
        hero_desc: 'Marketplace project, talent matching rule-based yang transparan, analisis skill gap, dan rekomendasi pembelajaran — dalam satu platform.',
        fitur_title: 'Fitur Unggulan', fitur_sub: 'Semua modul sudah hidup dan bisa dicoba lewat aplikasi.',
        cara_title: 'Cara Kerja', peran_title: 'Untuk Setiap Peran',
        daftar_title: 'Daftar Akun Baru', daftar_desc: 'Buat akun Mahasiswa, Perusahaan, atau Kampus — langsung bisa login tanpa akun demo.',
        cta_title: 'Siap menghubungkan kampus dan industri?', cta_desc: 'Login dengan akun demo atau akun baru Anda dan jelajahi semua halaman dashboard.',
        cta_app: 'Buka Aplikasi', cta_login: 'Halaman Login', cta_daftar: 'Daftar Sekarang',
        coba: 'Coba di aplikasi →',
      },
      en: {
        nav_fitur: 'Features', nav_cara: 'How it Works', nav_daftar: 'Sign Up', nav_masuk: 'Sign In', nav_buka: 'Open App',
        hero_badge: 'MVP · Campus × Industry', hero_title1: 'Bridge Campus', hero_title2: 'Industry',
        hero_desc: 'Project marketplace, transparent rule-based talent matching, skill gap analysis, and learning recommendations — in one platform.',
        fitur_title: 'Key Features', fitur_sub: 'All modules are live and tryable in the app.',
        cara_title: 'How it Works', peran_title: 'For Every Role',
        daftar_title: 'Create Account', daftar_desc: 'Create Student, Company, or Campus account — login instantly without demo account.',
        cta_title: 'Ready to bridge campus and industry?', cta_desc: 'Sign in with demo or your new account and explore the dashboard.',
        cta_app: 'Open App', cta_login: 'Sign In', cta_daftar: 'Sign Up Now',
        coba: 'Try in app →',
      }
    };

    function RegisterForm() {
      const [name, setName] = React.useState('');
      const [email, setEmail] = React.useState('');
      const [password, setPassword] = React.useState('');
      const [showPw, setShowPw] = React.useState(false);
      const [role, setRole] = React.useState('mahasiswa');
      const [err, setErr] = React.useState('');
      const [ok, setOk] = React.useState('');
      const [loading, setLoading] = React.useState(false);
      function pwScore(pw){ let s=0; if(pw.length>=8) s++; if(/[A-Za-z]/.test(pw) && /\d/.test(pw)) s++; if(/[^A-Za-z\d]/.test(pw)) s++; if(pw.length>=12 && s===3) s=4; return s; }
      const score = pwScore(password);
      const pwPct = [0,25,50,75,100][score];
      const pwColor = score<=1 ? 'bg-red-500' : score===2 ? 'bg-amber-500' : score===3 ? 'bg-emerald-500' : 'bg-emerald-600';
      const pwLabel = score===0 ? '' : score===1 ? 'Lemah — tambah angka & simbol' : score===2 ? 'Cukup — tambah simbol' : score===3 ? 'Kuat' : 'Sangat kuat';
      const ROLES = [
        { id: 'mahasiswa', icon: '🎓', label: 'Mahasiswa', desc: 'Skill & project' },
        { id: 'perusahaan', icon: '🏢', label: 'Perusahaan', desc: 'Buat project' },
        { id: 'kampus', icon: '🏛️', label: 'Kampus', desc: 'Analytics' },
      ];
      async function submit(e) {
        e.preventDefault(); setErr(''); setOk('');
        if (name.trim().length < 3) { setErr('Nama 3-100 karakter'); return; }
        if (score < 3) { setErr('Password belum memenuhi syarat (8 karakter, huruf+angka+simbol).'); return; }
        setLoading(true);
        try {
          const r = await fetch('/api/v1/auth/register', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name.trim(), email: email.trim(), password, role })
          });
          const j = await r.json();
          if (!j.success) {
            const msg = (j.errors && j.errors.length) ? j.errors.map(x=>x.message).join(', ') : j.message;
            setErr(msg || 'Pendaftaran gagal');
            return;
          }
          setOk('Pendaftaran berhasil! Mengalihkan ke aplikasi...');
          try { localStorage.setItem('token', j.data.token); } catch (ex) {}
          setTimeout(() => { window.location.href = '/app#/?token=' + encodeURIComponent(j.data.token); }, 600);
        } catch (ex) { setErr('Tidak dapat menghubungi server.'); }
        finally { setLoading(false); }
      }
      return (
        <form onSubmit={submit} className="bg-slate-950 border border-slate-800 rounded-2xl p-5">
          <label className="block text-xs font-medium text-slate-300 mb-1">Pilih peran</label>
          <div className="grid grid-cols-3 gap-2 mb-3">
            {ROLES.map((rc)=>(
              <button key={rc.id} type="button" onClick={()=>setRole(rc.id)} className={'rounded-xl border p-3 text-center transition ' + (role===rc.id ? 'bg-indigo-600 border-indigo-500 text-white' : 'bg-slate-900 border-slate-700 text-slate-300 hover:border-slate-500')}>
                <div className="text-lg">{rc.icon}</div><div className="text-xs font-bold">{rc.label}</div><div className="text-xs opacity-70">{rc.desc}</div>
              </button>
            ))}
          </div>
          <label className="block text-xs font-medium text-slate-300 mb-1">Nama Lengkap</label>
          <input value={name} onChange={(e)=>setName(e.target.value)} placeholder="Nama Anda" required minLength={3} maxLength={100} className="w-full rounded-lg bg-slate-900 border border-slate-700 text-slate-100 px-3 py-2 mb-3 text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          <label className="block text-xs font-medium text-slate-300 mb-1">Email</label>
          <input type="email" value={email} onChange={(e)=>setEmail(e.target.value)} placeholder="nama@email.com" required className="w-full rounded-lg bg-slate-900 border border-slate-700 text-slate-100 px-3 py-2 mb-3 text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          <label className="block text-xs font-medium text-slate-300 mb-1">Password</label>
          <div className="relative mb-1">
            <input type={showPw ? 'text' : 'password'} value={password} onChange={(e)=>setPassword(e.target.value)} placeholder="Min 8 karakter, huruf+angka+simbol" required className="w-full rounded-lg bg-slate-900 border border-slate-700 text-slate-100 px-3 py-2 pr-16 text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <button type="button" onClick={()=>setShowPw(!showPw)} className="absolute right-1.5 top-1.5 text-xs font-semibold text-slate-400 hover:text-slate-200 bg-slate-800 border border-slate-700 rounded-md px-2 py-1">{showPw ? 'Sembunyi' : 'Lihat'}</button>
          </div>
          {password && (
            <div className="mb-3">
              <div className="h-1.5 rounded bg-slate-800 overflow-hidden"><div className={'h-full ' + pwColor} style={{width: pwPct+'%'}}></div></div>
              <p className={'text-xs mt-1 ' + (score>=3 ? 'text-emerald-400' : 'text-amber-400')}>{pwLabel}</p>
            </div>
          )}
          {!password && <p className="text-xs text-slate-500 mb-3">Syarat: minimal 8 karakter, wajib huruf + angka + karakter spesial (contoh: Test123!).</p>}
          {err && <p className="text-sm text-red-400 bg-red-950/40 border border-red-800 rounded-lg px-3 py-2 mb-2">{err}</p>}
          {ok && <p className="text-sm text-emerald-400 bg-emerald-950/40 border border-emerald-800 rounded-lg px-3 py-2 mb-2">{ok}</p>}
          <button disabled={loading} className="w-full rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:opacity-60 text-white font-semibold py-2.5 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400">{loading ? 'Memproses...' : 'Daftar & Masuk'}</button>
          <p className="text-xs text-slate-500 mt-2 text-center">Sudah punya akun? <a href="/login" className="text-indigo-400 hover:text-indigo-300 underline">Masuk</a> · <a href="/app" className="text-indigo-400 hover:text-indigo-300 underline">Buka Aplikasi</a></p>
        </form>
      );
    }

    function App() {
      const [lang, setLang] = React.useState(localStorage.getItem('landing_lang') || 'id');
      const L = LANDING_I18N[lang] || LANDING_I18N.id;
      function toggleLang(){ const n = lang==='id' ? 'en' : 'id'; setLang(n); localStorage.setItem('landing_lang', n); }
      return (
        <div className="min-h-screen bg-slate-950 text-slate-200 flex flex-col">
          <nav className="sticky top-0 z-40 bg-slate-950/90 backdrop-blur border-b border-slate-800">
            <div className="w-full max-w-[1600px] mx-auto flex items-center justify-between px-6 lg:px-10 py-3.5">
              <a href="/" className="font-bold text-white tracking-tight">Campus Industry Talent Hub</a>
              <div className="flex items-center gap-2">
                <a href="#fitur" className="hidden lg:inline text-sm text-slate-400 hover:text-white px-3 py-2">{L.nav_fitur}</a>
                <a href="#cara-kerja" className="hidden lg:inline text-sm text-slate-400 hover:text-white px-3 py-2">{L.nav_cara}</a>
                <a href="#daftar" className="hidden lg:inline text-sm text-slate-400 hover:text-white px-3 py-2">{L.nav_daftar}</a>
                <div className="flex items-center bg-slate-900 border border-slate-800 rounded-full p-1 ml-1">
                  <button onClick={()=>{ if(lang!=='id'){ setLang('id'); localStorage.setItem('landing_lang','id'); } }} className={'text-xs font-bold px-2.5 py-1 rounded-full transition ' + (lang==='id' ? 'bg-white text-slate-900 shadow' : 'text-slate-400 hover:text-white')}>ID</button>
                  <button onClick={()=>{ if(lang!=='en'){ setLang('en'); localStorage.setItem('landing_lang','en'); } }} className={'text-xs font-bold px-2.5 py-1 rounded-full transition ' + (lang==='en' ? 'bg-white text-slate-900 shadow' : 'text-slate-400 hover:text-white')}>EN</button>
                </div>
                <a href="/login" className="text-sm text-slate-300 hover:text-white px-3 py-2">{L.nav_masuk}</a>
                <a href="/app" className="text-sm rounded-lg bg-indigo-600 hover:bg-indigo-500 transition text-white font-semibold px-4 py-2">{L.nav_buka}</a>
              </div>
            </div>
          </nav>

          <header className="flex-1 flex items-center bg-gradient-to-b from-indigo-950/70 via-slate-950 to-slate-950">
            <div className="w-full max-w-[1600px] mx-auto px-6 lg:px-10 py-10 lg:py-16">
              <div className="grid lg:grid-cols-2 gap-10 items-center">
                <div className="text-center lg:text-left">
                  <span className="inline-block text-xs font-semibold tracking-wide text-indigo-300 bg-indigo-950 border border-indigo-800 rounded-full px-3 py-1 mb-4">{L.hero_badge}</span>
                  <h1 className="text-4xl lg:text-5xl xl:text-6xl font-extrabold text-white leading-[1.05] tracking-tight">
                    {L.hero_title1} <span className="text-indigo-400">&amp;</span> {L.hero_title2}
                  </h1>
                  <p className="mt-4 text-slate-400 max-w-xl mx-auto lg:mx-0 text-base lg:text-lg leading-relaxed">
                    {L.hero_desc}
                  </p>
                  <div className="mt-7 flex flex-wrap gap-3 justify-center lg:justify-start">
                    <a href="/app" className="rounded-xl bg-indigo-600 hover:bg-indigo-500 transition text-white font-semibold px-7 py-3">{L.nav_buka}</a>
                    <a href="#cara-kerja" className="rounded-xl border border-slate-700 hover:border-slate-500 transition text-slate-200 px-7 py-3">{L.nav_cara}</a>
                  </div>
                  <div className="mt-8 flex flex-wrap gap-6 justify-center lg:justify-start text-sm text-slate-400">
                    <span><b className="text-white text-lg">31</b> skill</span>
                    <span><b className="text-white text-lg">4</b> role</span>
                    <span><b className="text-white text-lg">50/20/10/10/10</b> match</span>
                    <span><b className="text-white text-lg">74</b> endpoint</span>
                  </div>
                </div>
                <div className="hidden lg:block">
                  <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-2xl">
                    <div className="flex items-center gap-3 mb-4">
                      <div className="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold">CI</div>
                      <div><div className="text-sm font-bold text-white">Live Preview</div><div className="text-xs text-slate-500">Dashboard mahasiswa · match score</div></div>
                      <span className="ml-auto text-xs bg-emerald-500 text-white px-2 py-1 rounded-full font-bold">82</span>
                    </div>
                    <div className="space-y-2">
                      <div className="bg-slate-800 rounded-xl p-3 flex items-center gap-3"><div className="flex-1"><div className="text-sm font-semibold text-white">Website Company Profile</div><div className="text-xs text-slate-500">Teknologi · React ≥ 60</div></div><span className="text-xs font-bold px-2 py-1 rounded bg-emerald-600 text-white">82</span></div>
                      <div className="bg-slate-800 rounded-xl p-3 flex items-center gap-3"><div className="flex-1"><div className="text-sm font-semibold text-white">Mobile App Prototype</div><div className="text-xs text-slate-500">Mobile · Figma ≥ 50</div></div><span className="text-xs font-bold px-2 py-1 rounded bg-amber-500 text-slate-900">64</span></div>
                      <div className="bg-slate-800 rounded-xl p-3 flex items-center gap-3"><div className="flex-1"><div className="text-sm font-semibold text-white">Data Analysis Intern</div><div className="text-xs text-slate-500">Data · Python ≥ 70</div></div><span className="text-xs font-bold px-2 py-1 rounded bg-red-600 text-white">38</span></div>
                    </div>
                    <div className="mt-4 flex gap-2 text-xs text-slate-500"><span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-emerald-500"></span>kuat</span><span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-amber-500"></span>close</span><span className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-red-500"></span>lemah</span></div>
                  </div>
                </div>
              </div>
            </div>
          </header>

          <section id="fitur" className="w-full max-w-[1600px] mx-auto px-6 lg:px-10 py-12 lg:py-16">
            <div className="flex flex-wrap items-end justify-between gap-4 mb-6">
              <div>
                <h2 className="text-2xl lg:text-3xl font-bold text-white tracking-tight">{L.fitur_title}</h2>
                <p className="text-sm text-slate-500 mt-1">{L.fitur_sub}</p>
              </div>
              <a href="/app" className="text-sm text-indigo-400 hover:text-indigo-300">{L.coba}</a>
            </div>
            <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5">
              {FEATURES.map((f, i) => (
                <div key={f.t} className="bg-slate-900 border border-slate-800 hover:border-indigo-600/50 hover:shadow-lg hover:shadow-indigo-900/10 hover:-translate-y-0.5 transition-all rounded-2xl p-6 group">
                  <div className="w-9 h-9 rounded-xl bg-slate-800 group-hover:bg-indigo-600 flex items-center justify-center text-sm font-bold text-slate-400 group-hover:text-white transition mb-3">{['⌖','◈','◎','⬢','⬣','▦'][i] || '•'}</div>
                  <h3 className="font-semibold text-white mb-1">{f.t}</h3>
                  <p className="text-sm text-slate-400 leading-relaxed">{f.d}</p>
                </div>
              ))}
            </div>
          </section>

          <section id="cara-kerja" className="w-full max-w-[1600px] mx-auto px-6 lg:px-10 py-8 lg:py-12">
            <h2 className="text-2xl lg:text-3xl font-bold text-white mb-6 tracking-tight">{L.cara_title}</h2>
            <div className="grid md:grid-cols-3 gap-4 lg:gap-6">
              {STEPS.map((s) => (
                <div key={s.n} className="bg-slate-900 border border-slate-800 rounded-2xl p-6 flex gap-4">
                  <div className="w-10 h-10 rounded-xl bg-indigo-600 text-white font-bold flex items-center justify-center shrink-0">{s.n}</div>
                  <div><h3 className="font-semibold text-white mb-1">{s.t}</h3><p className="text-sm text-slate-400 leading-relaxed">{s.d}</p></div>
                </div>
              ))}
            </div>
          </section>

          <section className="w-full max-w-[1600px] mx-auto px-6 lg:px-10 py-8 lg:py-12">
            <h2 className="text-2xl lg:text-3xl font-bold text-white mb-6 tracking-tight">{L.peran_title}</h2>
            <div className="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
              {ROLES.map((r) => (
                <div key={r.name} className="bg-slate-900 border border-slate-800 hover:border-slate-600 transition rounded-2xl p-6 flex flex-col">
                  <h3 className="font-semibold text-white mb-1">{r.name}</h3>
                  <p className="text-sm text-slate-400 flex-1 leading-relaxed">{r.desc}</p>
                  <a href="/app" className="text-sm text-indigo-400 hover:text-indigo-300 mt-4 inline-flex items-center gap-1">Masuk sebagai {r.name} <span>→</span></a>
                </div>
              ))}
            </div>
          </section>

          <section id="daftar" className="w-full max-w-[1600px] mx-auto px-6 lg:px-10 py-8 lg:py-14">
            <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 lg:p-10">
              <div className="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
                <div>
                  <h2 className="text-2xl lg:text-3xl font-bold text-white tracking-tight">{L.daftar_title}</h2>
                  <p className="text-sm text-slate-400 mt-2 leading-relaxed">{L.daftar_desc}</p>
                  <ul className="mt-5 space-y-2 text-sm text-slate-400">
                    <li className="flex gap-2"><span className="text-indigo-400">•</span> Mahasiswa: isi skill & daftar project</li>
                    <li className="flex gap-2"><span className="text-indigo-400">•</span> Perusahaan: buat project & nilai pelamar</li>
                    <li className="flex gap-2"><span className="text-indigo-400">•</span> Kampus: pantau analytics & tren skill</li>
                  </ul>
                  <p className="text-xs text-slate-500 mt-6">Sudah punya akun? <a href="/login" className="text-indigo-400 hover:text-indigo-300 underline">Masuk di sini</a> · atau <a href="/register" className="text-indigo-400 hover:text-indigo-300 underline">halaman daftar terpisah</a></p>
                </div>
                <RegisterForm />
              </div>
            </div>
          </section>

          <section className="w-full max-w-[1600px] mx-auto px-6 lg:px-10 pb-12 lg:pb-16">
            <div className="bg-gradient-to-r from-indigo-900 to-slate-900 border border-indigo-800 rounded-3xl p-8 lg:p-12 text-center">
              <h2 className="text-2xl lg:text-3xl font-extrabold text-white tracking-tight">{L.cta_title}</h2>
              <p className="text-slate-400 mt-2 mb-6">{L.cta_desc}</p>
              <div className="flex flex-wrap gap-3 justify-center">
                <a href="/app" className="rounded-xl bg-white text-slate-900 font-semibold px-7 py-3 hover:bg-slate-200 transition">{L.cta_app}</a>
                <a href="/login" className="rounded-xl border border-slate-600 text-slate-200 px-7 py-3 hover:border-slate-400 transition">{L.cta_login}</a>
                <a href="#daftar" className="rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-7 py-3 transition">{L.cta_daftar}</a>
              </div>
            </div>
          </section>

          <footer className="border-t border-slate-800 mt-auto">
            <div className="w-full max-w-[1600px] mx-auto px-6 lg:px-10 py-6 flex flex-wrap gap-2 items-center justify-between text-xs text-slate-500">
              <span>Campus Industry Talent Hub</span>
              <span className="flex gap-4">
                <a className="hover:text-slate-300" href="/register">Daftar</a>
                <a className="hover:text-slate-300" href="/app">Aplikasi</a>
                <a className="hover:text-slate-300" href="/login">Masuk</a>
                <a className="hover:text-slate-300" href="/api/v1/health">API Health</a>
              </span>
            </div>
          </footer>
        </div>
      );
    }

    if (window.React && window.ReactDOM) {
      ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    } else {
      document.getElementById('root').innerHTML =
        '<div class="min-h-screen flex items-center justify-center text-slate-200 px-6 text-center">' +
        'CDN tidak dapat dimuat (butuh internet). Gunakan halaman <a class="underline" href="/login">/login</a>.</div>';
    }
  </script>
</body>
</html>
