<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Campus Industry Talent Hub</title>
  <!-- TASK-114: /app = halaman nyata per URL (hash routing: /app#/projects, …).
       UI system: Toast, EmptyState, Skeleton, ConfirmModal, responsif mobile,
       quick-fill akun demo. React 18 UMD + Tailwind v4 browser CDN. -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script crossorigin src="https://unpkg.com/react@18.2.0/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18.2.0/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone@7.23.5/babel.min.js"></script>
</head>
<body class="bg-slate-950">
  <div id="app"><div class="min-h-screen flex items-center justify-center text-slate-400">Memuat dashboard…</div></div>
  <noscript><div class="min-h-screen flex items-center justify-center text-slate-200">Aktifkan JavaScript.</div></noscript>
  <script type="text/babel" data-presets="react">
    const { useState, useEffect } = React;
    const API = '/api/v1';
    const INP = 'w-full rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-2 mb-2 text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition';
    const BTN = 'inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white text-sm font-semibold px-3.5 py-2 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 disabled:opacity-50 disabled:pointer-events-none';
    const BTN2 = 'inline-flex items-center justify-center rounded-lg border border-slate-600 hover:border-slate-400 hover:bg-slate-800 text-slate-200 text-sm font-medium px-3.5 py-2 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 disabled:opacity-50 disabled:pointer-events-none';
    const DANGER = 'inline-flex items-center justify-center rounded-lg border border-red-700 hover:bg-red-900/60 hover:border-red-600 text-red-300 text-sm font-medium px-3.5 py-2 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950';

    // ---- Routing: setiap halaman punya URL hash sendiri ----
    const HASH = {
      dash: '#/', projects: '#/projects', skills: '#/skills', gap: '#/gap',
      recs: '#/recommendations', myprojects: '#/my-projects', applications: '#/applications',
      assess: '#/assess', analytics: '#/analytics', notifs: '#/notifications', profile: '#/profile',
    };
    const VIEW_FROM_HASH = {};
    Object.keys(HASH).forEach((k) => { VIEW_FROM_HASH[HASH[k]] = k; });
    function viewFromHash() {
      const h = (window.location.hash || '#/').split('?')[0];
      return VIEW_FROM_HASH[h] || 'dash';
    }

    async function apiFetch(path, token) {
      const r = await fetch(API + path, { headers: { Authorization: 'Bearer ' + token } });
      if (r.status === 401) { const e = new Error('Sesi berakhir, silakan login ulang.'); e.code = 401; throw e; }
      return r.json();
    }
    async function apiSend(path, token, method, body) {
      const r = await fetch(API + path, {
        method, headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify(body || {}),
      });
      if (r.status === 401) { const e = new Error('Sesi berakhir, silakan login ulang.'); e.code = 401; throw e; }
      let j = {};
      try { j = await r.json(); } catch (ex) { j = { success: false, message: 'Respons tak terduga (' + r.status + ')' }; }
      if (!j.success) { const e = new Error(j.message || ('Gagal (' + r.status + ')')); e.code = r.status; throw e; }
      return j;
    }


    async function saveAssessment(payload, token) {
      const pid = payload.project_id; const sid = payload.student_id;
      try {
        const probe = await apiFetch('/evaluations/' + pid + '/' + sid, token);
        if (probe && probe.success && probe.data && probe.data.assessment) {
          return apiSend('/evaluations/' + pid + '/' + sid, token, 'PUT', payload);
        }
      } catch (e) { if (e.code === 401) throw e; }
      return apiSend('/assessments', token, 'POST', payload);
    }

    function matchColor(s) {
      if (s == null) return 'bg-slate-700 text-slate-200';
      if (s >= 70) return 'bg-green-600 text-white';
      if (s >= 40) return 'bg-yellow-500 text-slate-900';
      return 'bg-red-600 text-white';
    }
    function gapColor(c) {
      if (c === 'critical') return 'bg-red-600 text-white';
      if (c === 'large') return 'bg-orange-500 text-slate-900';
      if (c === 'medium') return 'bg-yellow-500 text-slate-900';
      if (c === 'small') return 'bg-emerald-600 text-white';
      return 'bg-slate-700 text-slate-200';
    }

    // ---- i18n: ID / EN (persist di localStorage) ----
    const I18N = {
      id: {
        nav_dash: 'Dashboard', nav_projects: 'Projects', nav_skills: 'My Skills', nav_gap: 'Gap Analysis', nav_recs: 'Recommendations',
        nav_myprojects: 'My Projects', nav_apps: 'Applications', nav_assess: 'Assess', nav_analytics: 'Analytics', nav_notifs: 'Notifikasi', nav_profile: 'Profil',
        search_placeholder: 'Cari...', search_projects: 'Cari project...', search_candidates: 'Cari kandidat...', search_skills: 'Cari skill...',
        lang_id: 'ID', lang_en: 'EN',
        ranking_title: 'Talent Matching — Ranking', ranking_desc: 'Kandidat terurut match score (50/20/10/10/10). Klik bar untuk lihat breakdown.',
      },
      en: {
        nav_dash: 'Dashboard', nav_projects: 'Projects', nav_skills: 'My Skills', nav_gap: 'Gap Analysis', nav_recs: 'Recommendations',
        nav_myprojects: 'My Projects', nav_apps: 'Applications', nav_assess: 'Assess', nav_analytics: 'Analytics', nav_notifs: 'Notifications', nav_profile: 'Profile',
        search_placeholder: 'Search...', search_projects: 'Search projects...', search_candidates: 'Search candidates...', search_skills: 'Search skills...',
        lang_id: 'ID', lang_en: 'EN',
        ranking_title: 'Talent Matching — Ranking', ranking_desc: 'Candidates sorted by match score (50/20/10/10/10). Click bar to see breakdown.',
      },
    };
    function tr(lang, key) { return (I18N[lang] && I18N[lang][key]) || (I18N.id[key] || key); }

    // ---- SearchInput: debounced ----
    function SearchInput(props) {
      const [val, setVal] = useState(props.value || '');
      useEffect(()=> setVal(props.value || ''), [props.value]);
      useEffect(()=>{
        const t = setTimeout(()=> { if (props.onSearch) props.onSearch(val); }, 300);
        return ()=> clearTimeout(t);
      }, [val]);
      return (
        <div className="relative flex-1 min-w-40">
          <span className="absolute left-2.5 top-2.5 text-slate-500">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </span>
          <input value={val} onChange={(e)=> setVal(e.target.value)} placeholder={props.placeholder || tr(props.lang || 'id','search_placeholder')} className="w-full rounded-lg bg-slate-800 border border-slate-700 text-slate-100 pl-8 pr-3 py-1.5 text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
      );
    }

    // ---- UI system ----
    function StatCard(props) {
      return (
        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition">
          <p className="text-xs uppercase tracking-wide text-slate-500">{props.label}</p>
          <p className="text-3xl font-extrabold text-white mt-1">{props.value}</p>
          {props.sub && <p className="text-xs text-slate-500 mt-1">{props.sub}</p>}
        </div>
      );
    }
    function Section(props) {
      return (
        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 mt-4 shadow-sm">
          <h3 className="text-sm font-semibold tracking-tight text-white mb-3">{props.title}</h3>
          {props.children}
        </div>
      );
    }
    function Bar(props) {
      const pct = Math.min(100, Math.max(0, (props.value / (props.max || 100)) * 100));
      return (
        <div className="flex items-center gap-2 py-1">
          <span className="w-36 truncate text-sm text-slate-300">{props.label}</span>
          <div className="flex-1 h-2.5 rounded bg-slate-800 overflow-hidden">
            <div className={'h-full rounded ' + (props.color || 'bg-indigo-500')} style={{ width: pct + '%' }}></div>
          </div>
          <span className="w-16 text-right text-sm text-slate-400">{props.value}</span>
        </div>
      );
    }
    function Msg(props) {
      if (!props.text) return null;
      return <p className={'text-sm mb-3 ' + (props.err ? 'text-red-400' : 'text-emerald-400')}>{props.text}</p>;
    }
    function Toasts(props) {
      return (
        <div className="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm">
          {props.items.map((t) => (
            <div key={t.id} className={'rounded-xl px-4 py-2.5 text-sm shadow-xl border ' + (t.err ? 'bg-red-950 border-red-700 text-red-200' : 'bg-emerald-950 border-emerald-700 text-emerald-200')}>
              {t.text}
            </div>
          ))}
        </div>
      );
    }
    function EmptyState(props) {
      return (
        <div className="text-center py-8 px-4 border border-dashed border-slate-700/60 rounded-xl bg-slate-800/20">
          <div className="w-10 h-10 mx-auto mb-3 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center">
            <div className="w-2.5 h-2.5 rounded-full bg-slate-500"></div>
          </div>
          <p className="text-sm font-semibold text-slate-300">{props.title}</p>
          {props.hint && <p className="text-xs text-slate-500 mt-1 max-w-sm mx-auto">{props.hint}</p>}
          {props.action && <div className="mt-3">{props.action}</div>}
        </div>
      );
    }
    function SkeletonList(props) {
      const rows = [];
      for (let i = 0; i < (props.n || 4); i++) rows.push(i);
      return (
        <div className="animate-pulse">
          {rows.map((i) => <div key={i} className="h-12 rounded-xl bg-slate-800/70 mb-2"></div>)}
        </div>
      );
    }
    function ConfirmModal(props) {
      if (!props.open) return null;
      return (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4" onClick={props.onCancel}>
          <div className="bg-slate-900 border border-slate-700 rounded-2xl p-6 max-w-sm w-full" onClick={(e) => e.stopPropagation()}>
            <h3 className="font-bold text-white mb-1">{props.title || 'Yakin?'}</h3>
            <p className="text-sm text-slate-400 mb-4">{props.text || 'Tindakan ini tidak dapat dibatalkan.'}</p>
            <div className="flex gap-2 justify-end">
              <button onClick={props.onCancel} className={BTN2}>Batal</button>
              <button onClick={props.onConfirm} className="inline-flex items-center justify-center rounded-lg bg-red-600 hover:bg-red-500 active:bg-red-700 text-white text-sm font-semibold px-3.5 py-2 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900">Ya, lanjutkan</button>
            </div>
          </div>
        </div>
      );
    }
    // ---- EvaluateModal — fitur khusus evaluasi (dedicated) ----
    function EvaluateModal(props) {
      if (!props.open) return null;
      const { project, student, onClose, onSubmit } = props;
      const [ratings, setRatings] = useState({ rating_skill: 4, rating_communication: 4, rating_punctuality: 4, rating_overall: 4 });
      const [comments, setComments] = useState('');
      const [saving, setSaving] = useState(false);
      const [msg, setMsg] = useState('');
      const bump = ratings.rating_skill >=4 ? 10 : ratings.rating_skill===3 ? 5 : 0;
      function setR(k,v){ setRatings(Object.assign({}, ratings, {[k]: Number(v)})); }
      async function handle(){
        setMsg(''); setSaving(true);
        try { await onSubmit({ project_id: project.id, student_id: student.id, ...ratings, comments: comments || undefined }); }
        catch(e){ setMsg(e.message); }
        finally{ setSaving(false); }
      }
      return (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" onClick={onClose}>
          <div className="bg-slate-900 border border-slate-700 rounded-2xl max-w-lg w-full max-h-[90vh] overflow-auto" onClick={(e)=> e.stopPropagation()}>
            <div className="sticky top-0 bg-slate-900 border-b border-slate-800 p-5 pb-3">
              <h3 className="font-bold text-white">Evaluasi — {student.name}</h3>
              <p className="text-xs text-slate-500">{project.judul} · {student.email || ('ID '+student.id)}</p>
              {project.status !== 'closed' && <div className="mt-2 bg-amber-950/40 border border-amber-800 rounded-lg px-3 py-2 text-xs text-amber-300">Project status <b>{project.status}</b> — akan ditutup otomatis saat menilai (syarat: closed).</div>}
            </div>
            <div className="p-5">
              <div className="grid grid-cols-2 gap-3 mb-3">
                {[['rating_skill','Skill'],['rating_communication','Komunikasi'],['rating_punctuality','Ketepatan'],['rating_overall','Overall']].map(([k,label])=> (
                  <label key={k} className="text-xs text-slate-400">{label} <span className="text-indigo-400 font-bold">{ratings[k]}/5</span>
                    <select value={ratings[k]} onChange={(e)=> setR(k, e.target.value)} className="mt-1 w-full rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-2 py-2 text-sm">
                      {[1,2,3,4,5].map(v=> <option key={v} value={v}>{v} — {v===5?'Sangat baik':v===4?'Baik':v===3?'Cukup':v===2?'Kurang':'Sangat kurang'}</option>)}
                    </select>
                  </label>
                ))}
              </div>
              <div className={'rounded-lg px-3 py-2 mb-3 text-xs border ' + (bump===10 ? 'bg-emerald-950/40 border-emerald-800 text-emerald-300' : bump===5 ? 'bg-amber-950/30 border-amber-800 text-amber-300' : 'bg-slate-800 border-slate-700 text-slate-400')}>
                Skill bump preview: {bump===0 ? 'Tidak ada kenaikan (rating <3)' : '+' + bump + ' poin pada skill project (cap 100)'}
              </div>
              <label className="block text-xs text-slate-400 mb-1">Komentar (opsional)</label>
              <textarea value={comments} onChange={(e)=> setComments(e.target.value)} placeholder="Feedback membangun..." rows="3" className={INP}></textarea>
              {msg && <p className="text-sm text-red-400 bg-red-950/30 border border-red-800 rounded-lg px-3 py-2 mt-2">{msg}</p>}
              <div className="flex gap-2 justify-end mt-4">
                <button onClick={onClose} className={BTN2}>Batal</button>
                <button onClick={handle} disabled={saving} className={BTN}>{saving ? 'Menyimpan...' : (project.status !== 'closed' ? 'Tutup & Nilai' : 'Kirim Nilai')}</button>
              </div>
            </div>
          </div>
        </div>
      );
    }
    function PageHead(props) {
      return (
        <div className="flex flex-wrap items-end gap-3 mb-5">
          <div className="flex-1 min-w-52">
            <h1 className="text-2xl font-extrabold tracking-tight text-white">{props.title}</h1>
            {props.desc && <p className="text-sm text-slate-500 mt-1 leading-relaxed">{props.desc}</p>}
          </div>
          {props.action}
        </div>
      );
    }

    const DEMO_ACCOUNTS = [
      { role: 'Mahasiswa', email: 'mhs@test.id' },
      { role: 'Perusahaan', email: 'perusahaan@test.id' },
      { role: 'Kampus', email: 'kampus@test.id' },
      { role: 'Dosen', email: 'dosen@test.id' },
    ];

    function LoginView(props) {
      const [mode, setMode] = useState('login');
      const [name, setName] = useState('');
      const [email, setEmail] = useState('');
      const [password, setPassword] = useState('');
      const [showPw, setShowPw] = useState(false);
      const [role, setRole] = useState('mahasiswa');
      const [err, setErr] = useState('');
      const [ok, setOk] = useState('');
      const [loading, setLoading] = useState(false);
      function pwScore(pw){ let s=0; if(pw.length>=8) s++; if(/[A-Za-z]/.test(pw) && /\d/.test(pw)) s++; if(/[^A-Za-z\d]/.test(pw)) s++; if(pw.length>=12 && s===3) s=4; return s; }
      const score = pwScore(password);
      async function submitLogin(e) {
        e.preventDefault(); setErr(''); setOk(''); setLoading(true);
        try {
          const r = await fetch(API + '/auth/login', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });
          const j = await r.json();
          if (!j.success) { setErr(j.message || 'Login gagal'); return; }
          props.onLogin(j.data.token, j.data.user);
        } catch (ex) { setErr('Tidak dapat menghubungi server.'); }
        finally { setLoading(false); }
      }
      async function submitRegister(e) {
        e.preventDefault(); setErr(''); setOk('');
        if (name.trim().length < 3) { setErr('Nama 3-100 karakter'); return; }
        if (score < 3) { setErr('Password belum memenuhi syarat (8 karakter, huruf+angka+simbol).'); return; }
        setLoading(true);
        try {
          const r = await fetch(API + '/auth/register', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name.trim(), email: email.trim(), password, role }),
          });
          const j = await r.json();
          if (!j.success) {
            const msg = (j.errors && j.errors.length) ? j.errors.map(x=>x.message).join(', ') : j.message;
            setErr(msg || 'Pendaftaran gagal');
            return;
          }
          setOk('Pendaftaran berhasil! Memuat dashboard...');
          setTimeout(()=> props.onLogin(j.data.token, j.data.user), 400);
        } catch (ex) { setErr('Tidak dapat menghubungi server.'); }
        finally { setLoading(false); }
      }
      function fillDemo(mail) { setMode('login'); setEmail(mail); setPassword('Test123!'); setErr(''); setOk(''); }
      const ROLES = [
        { id: 'mahasiswa', icon: '🎓', label: 'Mahasiswa' },
        { id: 'perusahaan', icon: '🏢', label: 'Perusahaan' },
        { id: 'kampus', icon: '🏛️', label: 'Kampus' },
      ];
      return (
        <div className="min-h-screen flex items-center justify-center px-4 py-6">
          <div className="w-full max-w-sm">
            <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
              <div className="flex items-center gap-2 mb-1">
                <div className="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-sm">CI</div>
                <h1 className="font-bold text-white">Talent Hub</h1>
                <span className="ml-auto text-xs text-slate-500"><a className="underline" href="/">Landing</a></span>
              </div>
              <div className="flex gap-1 bg-slate-800 rounded-lg p-1 mb-5 mt-3">
                <button onClick={()=>{setMode('login'); setErr(''); setOk('');}} className={'flex-1 text-sm font-semibold rounded-md py-1.5 transition ' + (mode==='login' ? 'bg-slate-700 text-white' : 'text-slate-400 hover:text-slate-200')}>Masuk</button>
                <button onClick={()=>{setMode('register'); setErr(''); setOk('');}} className={'flex-1 text-sm font-semibold rounded-md py-1.5 transition ' + (mode==='register' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-slate-200')}>Daftar</button>
              </div>
              {mode === 'login' ? (
                <form onSubmit={submitLogin}>
                  <p className="text-sm text-slate-400 mb-4">Login untuk melihat dashboard sesuai peran.</p>
                  <label className="block text-xs font-medium text-slate-300 mb-1">Email</label>
                  <input type="email" required value={email} onChange={(e) => setEmail(e.target.value)} placeholder="nama@email.com" className={INP} />
                  <label className="block text-xs font-medium text-slate-300 mb-1">Password</label>
                  <div className="relative">
                    <input type={showPw ? 'text' : 'password'} required value={password} onChange={(e) => setPassword(e.target.value)} placeholder="Password" className={INP + ' pr-16'} />
                    <button type="button" onClick={()=>setShowPw(!showPw)} className="absolute right-1.5 top-1.5 text-xs font-semibold text-slate-400 hover:text-slate-200 bg-slate-800 border border-slate-700 rounded-md px-2 py-1">{showPw ? 'Sembunyi' : 'Lihat'}</button>
                  </div>
                  {err && <p className="text-sm text-red-400 bg-red-950/30 border border-red-800 rounded-lg px-3 py-2 mt-2">{err}</p>}
                  {ok && <p className="text-sm text-emerald-400 bg-emerald-950/30 border border-emerald-800 rounded-lg px-3 py-2 mt-2">{ok}</p>}
                  <button disabled={loading} className="w-full rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:opacity-60 text-white font-semibold py-2.5 mt-3 transition">{loading ? 'Memproses...' : 'Masuk'}</button>
                </form>
              ) : (
                <form onSubmit={submitRegister}>
                  <p className="text-sm text-slate-400 mb-3">Buat akun baru — langsung bisa dipakai.</p>
                  <div className="grid grid-cols-3 gap-2 mb-3">
                    {ROLES.map((rc)=>(
                      <button key={rc.id} type="button" onClick={()=>setRole(rc.id)} className={'rounded-xl border p-2.5 text-center transition ' + (role===rc.id ? 'bg-indigo-600 border-indigo-500 text-white' : 'bg-slate-800 border-slate-700 text-slate-300 hover:border-slate-500')}>
                        <div className="text-base">{rc.icon}</div><div className="text-xs font-bold">{rc.label}</div>
                      </button>
                    ))}
                  </div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">Nama Lengkap</label>
                  <input value={name} onChange={(e)=>setName(e.target.value)} placeholder="Nama Anda" required minLength={3} maxLength={100} className={INP} />
                  <label className="block text-xs font-medium text-slate-300 mb-1">Email</label>
                  <input type="email" value={email} onChange={(e)=>setEmail(e.target.value)} placeholder="nama@email.com" required className={INP} />
                  <label className="block text-xs font-medium text-slate-300 mb-1">Password</label>
                  <div className="relative">
                    <input type={showPw ? 'text' : 'password'} value={password} onChange={(e)=>setPassword(e.target.value)} placeholder="Min 8 huruf+angka+simbol" required className={INP + ' pr-16'} />
                    <button type="button" onClick={()=>setShowPw(!showPw)} className="absolute right-1.5 top-1.5 text-xs font-semibold text-slate-400 hover:text-slate-200 bg-slate-800 border border-slate-700 rounded-md px-2 py-1">{showPw ? 'Sembunyi' : 'Lihat'}</button>
                  </div>
                  {password && (
                    <div className="mb-2">
                      <div className="h-1.5 rounded bg-slate-800 overflow-hidden"><div className={'h-full ' + (score<=1 ? 'bg-red-500' : score===2 ? 'bg-amber-500' : 'bg-emerald-500')} style={{width: [0,25,50,75,100][score]+'%'}}></div></div>
                      <p className={'text-xs mt-1 ' + (score>=3 ? 'text-emerald-400' : 'text-amber-400')}>{score===1 ? 'Lemah' : score===2 ? 'Cukup' : score>=3 ? 'Kuat' : ''}</p>
                    </div>
                  )}
                  {err && <p className="text-sm text-red-400 bg-red-950/30 border border-red-800 rounded-lg px-3 py-2 mt-2">{err}</p>}
                  {ok && <p className="text-sm text-emerald-400 bg-emerald-950/30 border border-emerald-800 rounded-lg px-3 py-2 mt-2">{ok}</p>}
                  <button disabled={loading} className="w-full rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:opacity-60 text-white font-semibold py-2.5 mt-3 transition">{loading ? 'Memproses...' : 'Daftar & Masuk'}</button>
                  <p className="text-xs text-slate-500 mt-2 text-center">Sudah ada akun? <button type="button" onClick={()=>setMode('login')} className="text-indigo-400 underline">Masuk</button></p>
                </form>
              )}
            </div>
            <div className="bg-slate-900/60 border border-slate-800 rounded-2xl p-4 mt-3">
              <p className="text-xs text-slate-400 mb-2">Akun demo — klik untuk isi otomatis (login tab):</p>
              <div className="flex flex-wrap gap-1.5">
                {DEMO_ACCOUNTS.map((d) => (
                  <button key={d.email} type="button" onClick={() => fillDemo(d.email)} className="text-xs rounded-lg border border-slate-700 hover:border-indigo-500 text-slate-300 px-2 py-1 transition">{d.role}</button>
                ))}
              </div>
            </div>
          </div>
        </div>
      );
    }

