    function AnalyticsView(props) {
      const [pie, setPie] = useState(null);
      const [line, setLine] = useState(null);
      const [heat, setHeat] = useState(null);
      const [err, setErr] = useState('');
      useEffect(() => {
        let alive = true;
        Promise.all([
          apiFetch('/analytics/skill-distribution', props.token),
          apiFetch('/analytics/industry-demand', props.token),
          apiFetch('/analytics/gap-heatmap', props.token),
        ]).then((arr) => { if (alive) { setPie(arr[0].data); setLine(arr[1].data); setHeat(arr[2].data); } })
          .catch((e) => { if (alive) { if (e.code === 401) props.onExpire(); else setErr(e.message); } });
        return () => { alive = false; };
      }, []);
      async function downloadCsv() {
        try {
          const r = await fetch(API + '/analytics/export?format=csv', { headers: { Authorization: 'Bearer ' + props.token } });
          if (r.status === 401) { props.onExpire(); return; }
          const blob = await r.blob();
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob); a.download = 'gap-export.csv'; a.click();
          props.notify('CSV terunduh.');
        } catch (ex) { setErr('Gagal mengunduh CSV.'); }
      }
      if (err) return <p className="text-sm text-red-400">{err}</p>;
      if (!pie || !line || !heat) return <SkeletonList n={6} />;
      const maxDist = Math.max.apply(null, [1].concat(pie.distribution.map((s) => s.students)));
      const maxTop = Math.max.apply(null, [1].concat(line.top_skills.map((s) => s.c)));
      return (
        <div>
          <PageHead title="Analytics" desc="Distribusi skill, tren industri, dan heatmap gap." action={<button onClick={downloadCsv} className={BTN}>Export CSV</button>} />
          <Section title={'Distribusi Skill (' + pie.total_students + ' mahasiswa)'}>
            {pie.distribution.slice(0, 12).map((s) => (
              <Bar key={s.name} label={s.name + ' (' + s.avg_level + ')'} value={s.students} max={maxDist} />
            ))}
          </Section>
          <Section title="Tren Skill Dicari Industri">
            {line.top_skills.map((s) => <Bar key={s.skill} label={s.skill} value={s.c} max={maxTop} color="bg-emerald-500" />)}
          </Section>
          <Section title="Heatmap Gap per Prodi">
            {heat.matrix.length === 0 && <EmptyState title="Belum ada data prodi" hint="Lengkapi profil mahasiswa (program studi)." />}
            {heat.matrix.length > 0 && (
            <div className="overflow-x-auto">
              <table className="text-xs text-slate-300 border-collapse">
                <thead><tr><th className="p-1.5 text-left">Prodi</th>
                  {heat.skills.map((s) => <th key={s} className="p-1.5 text-left font-normal">{s}</th>)}
                </tr></thead>
                <tbody>
                  {heat.matrix.map((row) => (
                    <tr key={row.program_studi} className="border-t border-slate-800">
                      <td className="p-1.5 font-semibold">{row.program_studi}</td>
                      {heat.skills.map((s) => {
                        const v = row.gaps[s] || 0;
                        const a = Math.min(0.85, v / 60);
                        return <td key={s} className="p-1.5 text-center" style={{ background: 'rgba(239,68,68,' + a + ')' }}>{v}</td>;
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            )}
          </Section>
        </div>
      );
    }

    // ---- Halaman: Projects (mahasiswa) — dengan Search ----
    function ProjectsView(props) {
      const lang = props.lang || 'id';
      const [list, setList] = useState([]);
      const [loading, setLoading] = useState(true);
      const [sektor, setSektor] = useState('');
      const [diff, setDiff] = useState('');
      const [sort, setSort] = useState('terbaru');
      const [search, setSearch] = useState('');
      const [detail, setDetail] = useState(null);
      const [cover, setCover] = useState('');
      const [msg, setMsg] = useState('');
      const [isErr, setIsErr] = useState(false);
      async function browse() {
        setLoading(true); setMsg(''); setIsErr(false);
        try {
          const q = [];
          if (sektor) q.push('filter[sektor_industri]=' + encodeURIComponent(sektor));
          if (diff) q.push('filter[difficulty]=' + diff);
          if (search.trim()) q.push('filter[skill]=' + encodeURIComponent(search.trim()));
          q.push('filter[status]=active');
          q.push('sort=' + sort);
          const j = await apiFetch('/projects?' + q.join('&'), props.token);
          let arr = j.data.projects || [];
          // Client-side tambahan: filter judul yang mengandung search (karena skill filter hanya untuk skill)
          if (search.trim()) {
            const needle = search.trim().toLowerCase();
            arr = arr.filter(p=> p.judul.toLowerCase().includes(needle) || (p.sektor_industri||'').toLowerCase().includes(needle) || (p.skills||[]).some(s=> (s.name||'').toLowerCase().includes(needle)));
          }
          setList(arr);
          setDetail(null);
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
        finally { setLoading(false); }
      }
      useEffect(() => { browse(); }, []);
      async function openDetail(id) {
        try {
          const j = await apiFetch('/projects/' + id, props.token);
          setDetail(j.data.project); setCover(''); setMsg(''); setIsErr(false);
        } catch (e) { if (e.code === 401) props.onExpire(); else props.notify(e.message, true); }
      }
      async function apply(id) {
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/projects/' + id + '/apply', props.token, 'POST', { cover_letter: cover || undefined });
          props.notify('Aplikasi terkirim.');
          browse();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      return (
        <div>
          <PageHead title={tr(lang,'nav_projects')} desc={lang==='en' ? 'Browse active industry projects and apply by skill.' : 'Jelajahi project aktif industri dan daftar sesuai skill.'} />
          <div className="flex flex-wrap gap-2 mb-3 items-center">
            <SearchInput value={search} onSearch={setSearch} placeholder={tr(lang,'search_projects')} lang={lang} />
            <input value={sektor} onChange={(e) => setSektor(e.target.value)} placeholder={lang==='en' ? 'Sector…' : 'Sektor…'} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm w-32" />
            <select value={diff} onChange={(e) => setDiff(e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
              <option value="">{lang==='en' ? 'All difficulty' : 'Semua difficulty'}</option><option value="easy">Easy</option><option value="medium">Medium</option><option value="hard">Hard</option>
            </select>
            <select value={sort} onChange={(e) => setSort(e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
              <option value="terbaru">{lang==='en' ? 'Newest' : 'Terbaru'}</option><option value="deadline">Deadline</option><option value="match_score">Match score</option>
            </select>
            <button onClick={browse} className={BTN}>{lang==='en' ? 'Search' : 'Cari'}</button>
          </div>
          <Msg text={msg} err={isErr} />
          {loading && <SkeletonList />}
          {!loading && list.length === 0 && <EmptyState title="Tidak ada project cocok" hint="Ubah filter atau cek lagi nanti." />}
          {!loading && list.map((p) => (
            <div key={p.id} className="bg-slate-900 border border-slate-800 hover:border-slate-600 transition rounded-2xl p-4 mb-2 flex items-center gap-3">
              <span className="flex-1 text-sm text-slate-200">{p.judul} <span className="text-slate-500">· {p.sektor_industri || '–'} · {p.difficulty || '–'} · {p.deadline || '–'}</span></span>
              {p.match_score != null && <span className={'text-xs font-bold px-2 py-1 rounded ' + matchColor(p.match_score)}>{p.match_score}</span>}
              <button onClick={() => openDetail(p.id)} className={BTN2}>Detail</button>
            </div>
          ))}
          {detail && (
            <Section title={'Detail: ' + detail.judul}>
              <p className="text-sm text-slate-300 mb-2">{detail.deskripsi || '(tanpa deskripsi)'}</p>
              <p className="text-xs text-slate-500 mb-2">Sektor: {detail.sektor_industri || '–'} · Deadline: {detail.deadline || '–'} · Status: {detail.status}</p>
              <div className="flex flex-wrap gap-2 mb-3">
                {(detail.skills || []).map((s) => (
                  <span key={s.skill_id || s.id} className="text-xs bg-slate-800 text-slate-200 px-2 py-1 rounded">{s.name || ('Skill #' + (s.skill_id || s.id))} ≥ {s.level_required}</span>
                ))}
              </div>
              <textarea value={cover} onChange={(e) => setCover(e.target.value)} placeholder="Cover letter (opsional)" rows="2" className={INP}></textarea>
              <button onClick={() => apply(detail.id)} className={BTN}>Daftar Project Ini</button>
            </Section>
          )}
        </div>
      );
    }

    // ---- Halaman: My Skills (mahasiswa) — dengan Search ----
    function SkillsView(props) {
      const lang = props.lang || 'id';
      const [mine, setMine] = useState([]);
      const [loading, setLoading] = useState(true);
      const [tax, setTax] = useState([]);
      const [sid, setSid] = useState('');
      const [level, setLevel] = useState(50);
      const [source, setSource] = useState('course');
      const [editId, setEditId] = useState(null);
      const [editLevel, setEditLevel] = useState(50);
      const [pendingDel, setPendingDel] = useState(null);
      const [msg, setMsg] = useState('');
      const [isErr, setIsErr] = useState(false);
      const [q, setQ] = useState('');
      async function load() {
        setLoading(true);
        try {
          const a = await apiFetch('/students/skills', props.token);
          setMine(a.data.skills || []);
          const b = await apiFetch('/skills', props.token);
          const arr = b.data.skills || [];
          setTax(arr);
          if (!sid && arr.length > 0) setSid(String(arr[0].id));
        } catch (e) { if (e.code === 401) props.onExpire(); else props.notify(e.message, true); }
        finally { setLoading(false); }
      }
      useEffect(() => { load(); }, []);
      async function add() {
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/students/skills', props.token, 'POST', { skill_id: Number(sid), proficiency_level: Number(level), source });
          props.notify('Skill ditambahkan.'); load();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      async function save(id) {
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/students/skills/' + id, props.token, 'PUT', { proficiency_level: Number(editLevel) });
          setEditId(null); props.notify('Skill diupdate.'); load();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      async function del(id) {
        setPendingDel(null); setMsg(''); setIsErr(false);
        try {
          await apiSend('/students/skills/' + id, props.token, 'DELETE');
          props.notify('Skill dihapus.'); load();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      const needle = q.trim().toLowerCase();
      const filteredMine = mine.filter(s=> !needle || s.name.toLowerCase().includes(needle) || s.source.toLowerCase().includes(needle));
      return (
        <div>
          <PageHead title={tr(lang,'nav_skills')} desc={lang==='en' ? 'Manage your skills and proficiency.' : 'Kelola skill dan level penguasaan.'} />
          <Msg text={msg} err={isErr} />
          <div className="mb-3"><SearchInput value={q} onSearch={setQ} placeholder={tr(lang,'search_skills')} lang={lang} /></div>
          <Section title="Tambah Skill">
            <div className="flex flex-wrap gap-2">
              <select value={sid} onChange={(e) => setSid(e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
                {tax.map((s) => <option key={s.id} value={s.id}>{s.name} [{s.category}]</option>)}
              </select>
              <input type="number" min="0" max="100" value={level} onChange={(e) => setLevel(e.target.value)} className="w-20 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm" />
              <select value={source} onChange={(e) => setSource(e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
                <option value="course">course</option><option value="certification">certification</option><option value="experience">experience</option>
              </select>
              <button onClick={add} className={BTN}>Tambah</button>
            </div>
          </Section>
          <Section title={'Skill Saya (' + filteredMine.length + '/' + mine.length + ')'}>
            {loading && <SkeletonList n={3} />}
            {!loading && filteredMine.length === 0 && <EmptyState title={needle ? 'Tidak ada skill cocok' : 'Belum ada skill'} hint={needle ? 'Coba kata kunci lain.' : 'Tambahkan skill pertama dari taxonomy di atas.'} />}
            {!loading && filteredMine.map((s) => (
              <div key={s.skill_id} className="py-2 border-b border-slate-800 last:border-0">
                <div className="flex items-center gap-2">
                  <span className="flex-1 text-sm text-slate-200">{s.name} <span className="text-slate-500">[{s.proficiency_category} · {s.source}]</span></span>
                  <span className="text-sm text-slate-300 w-10 text-right">{s.proficiency_level}</span>
                  <button onClick={() => { setEditId(s.skill_id); setEditLevel(s.proficiency_level); }} className={BTN2}>Edit</button>
                  <button onClick={() => setPendingDel(s.skill_id)} className={DANGER}>Hapus</button>
                </div>
                {editId === s.skill_id && (
                  <div className="flex gap-2 mt-2">
                    <input type="number" min="0" max="100" value={editLevel} onChange={(e) => setEditLevel(e.target.value)} className="w-20 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm" />
                    <button onClick={() => save(s.skill_id)} className={BTN}>Simpan</button>
                    <button onClick={() => setEditId(null)} className={BTN2}>Batal</button>
                  </div>
                )}
              </div>
            ))}
          </Section>
          <ConfirmModal open={pendingDel != null} title="Hapus skill?" text="Skill yang masih dipakai aplikasi aktif tidak bisa dihapus." onCancel={() => setPendingDel(null)} onConfirm={() => del(pendingDel)} />
        </div>
      );
    }

    // ---- Halaman: Gap Analysis (mahasiswa) ----
    function GapView(props) {
      const [projects, setProjects] = useState([]);
      const [pid, setPid] = useState('');
      const [result, setResult] = useState(null);
      const [running, setRunning] = useState(false);
      const [msg, setMsg] = useState('');
      useEffect(() => {
        apiFetch('/projects?filter[status]=active&sort=terbaru', props.token)
          .then((j) => {
            const arr = j.data.projects || [];
            setProjects(arr);
            if (arr.length > 0) setPid(String(arr[0].id));
          })
          .catch((e) => { if (e.code === 401) props.onExpire(); });
      }, []);
      async function run() {
        setMsg(''); setRunning(true);
        try {
          const j = await apiFetch('/gap-analysis/' + props.user.id + '/' + pid, props.token);
          setResult(j.data);
          props.notify('Analisis selesai — rekomendasi ikut dibuat.');
        } catch (e) { if (e.code === 401) props.onExpire(); else setMsg(e.message); }
        finally { setRunning(false); }
      }
      return (
        <div>
          <PageHead title="Gap Analysis" desc="Bandingkan skill dengan requirement project." />
          <div className="flex gap-2 mb-3">
            <select value={pid} onChange={(e) => setPid(e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
              {projects.map((p) => <option key={p.id} value={p.id}>{p.judul}</option>)}
            </select>
            <button onClick={run} disabled={running || !pid} className={BTN + ' disabled:opacity-60'}>{running ? 'Menganalisis…' : 'Analisis'}</button>
          </div>
          {msg && <p className="text-sm text-red-400 mb-3">{msg}</p>}
          {running && <SkeletonList n={5} />}
          {!running && !result && <EmptyState title="Belum ada hasil" hint="Pilih project lalu tekan Analisis." />}
          {!running && result && (
            <Section title="Hasil Analisis">
              <div className="overflow-x-auto">
                <table className="text-sm text-slate-200 w-full">
                  <thead><tr className="text-left text-slate-500 text-xs">
                    <th className="py-1">Skill</th><th className="py-1">Butuh</th><th className="py-1">Saya</th><th className="py-1">Gap</th><th className="py-1">Klasifikasi</th>
                  </tr></thead>
                  <tbody>
                    {(result.gaps || []).map((g) => (
                      <tr key={g.skill_id} className="border-t border-slate-800">
                        <td className="py-1.5">{g.name}</td><td>{g.required}</td><td>{g.current}</td>
                        <td className="font-bold">{g.gap_value}</td>
                        <td><span className={'text-xs font-bold px-2 py-0.5 rounded ' + gapColor(g.classification)}>{g.classification}</span></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {result.summary && <p className="text-xs text-slate-500 mt-2">Ringkasan: {JSON.stringify(result.summary)}</p>}
            </Section>
          )}
        </div>
      );
    }

    // ---- Halaman: Recommendations (mahasiswa) — modul belajar interaktif ----
    function RecsView(props) {
      const [list, setList] = useState([]);
      const [loading, setLoading] = useState(true);
      const [acting, setActing] = useState(null);
      const [expanded, setExpanded] = useState({});
      const [checks, setChecks] = useState({});
      const [filter, setFilter] = useState('all');

      const TYPE_META = {
        course: { icon: '📚', label: 'Course', color: 'bg-sky-600 text-white' },
        workshop: { icon: '🛠️', label: 'Workshop', color: 'bg-amber-600 text-white' },
        certification: { icon: '🎖️', label: 'Sertifikasi', color: 'bg-violet-600 text-white' },
        'practice-project': { icon: '💻', label: 'Practice', color: 'bg-emerald-600 text-white' },
        mentor: { icon: '🧑‍🏫', label: 'Mentor', color: 'bg-fuchsia-600 text-white' },
      };
      const PRIO = { high: 'bg-red-600 text-white', medium: 'bg-amber-500 text-slate-900', low: 'bg-slate-600 text-slate-100' };
      function moduleSteps(r) {
        const s = r.title.replace(/^(Course|Workshop intensif|Sertifikasi|Practice project|Mentor):\s*/,'');
        const base = {
          course: [
            { id: 'c1', t: 'Tonton materi intro — ' + s + ' (15–30 menit)', d: 'Video/overview + ringkasan' },
            { id: 'c2', t: 'Baca handout & contoh kode', d: 'File materi di sumber modul' },
            { id: 'c3', t: 'Kerjakan latihan mini', d: 'Quiz/latihan 5 soal' },
          ],
          workshop: [
            { id: 'w1', t: 'Ikuti sesi workshop intensif', d: 'Live/hybrid 2 jam' },
            { id: 'w2', t: 'Catat poin penting & diskusi', d: 'Forum Q&A' },
            { id: 'w3', t: 'Selesaikan tugas workshop', d: 'Upload hasil' },
          ],
          certification: [
            { id: 'f1', t: 'Pilih lembaga/jadwal sertifikasi', d: 'Cek prasyarat' },
            { id: 'f2', t: 'Pelajari outline & mock exam', d: 'Bank soal' },
            { id: 'f3', t: 'Daftar & jadwalkan ujian', d: 'Bukti pendaftaran' },
          ],
          'practice-project': [
            { id: 'p1', t: 'Clone / setup repo practice', d: 'Starter kit' },
            { id: 'p2', t: 'Implement fitur inti', d: 'Commit bertahap' },
            { id: 'p3', t: 'Push & minta review', d: 'PR / demo' },
          ],
          mentor: [
            { id: 'm1', t: 'Jadwalkan sesi 1: mapping gap', d: '30 menit' },
            { id: 'm2', t: 'Sesi 2–3: bimbingan progres', d: '1 jam/minggu' },
            { id: 'm3', t: 'Sesi 4: review & next steps', d: 'Feedback mentor' },
          ],
        };
        return base[r.type] || base.course;
      }

      async function load() {
        setLoading(true);
        try {
          const j = await apiFetch('/recommendations/student/' + props.user.id, props.token);
          if (!j.success) throw new Error(j.message || 'Gagal memuat rekomendasi');
          setList(j.data.recommendations || []);
        } catch (e) {
          if (e.code === 401) props.onExpire();
          else props.notify(e.message || 'Gagal memuat rekomendasi', true);
        } finally { setLoading(false); }
      }
      useEffect(() => { load(); }, []);
      async function act(id, action, label) {
        setActing(id + ':' + action);
        try {
          await apiSend('/recommendations/' + id + '/action', props.token, 'POST', { action });
          props.notify(label + ' tersimpan.');
          await load();
        } catch (e) {
          if (e.code === 401) props.onExpire();
          else props.notify(e.message || 'Aksi gagal', true);
        } finally { setActing(null); }
      }
      const counts = { pending: 0, 'in-progress': 0, completed: 0, consumed: 0 };
      list.forEach((r) => { if (counts[r.status] !== undefined) counts[r.status] += 1; });
      const total = list.length;
      const done = counts.completed + counts.consumed;
      const pct = total ? Math.round((done / total) * 100) : 0;
      const filtered = list.filter((r) => filter === 'all' ? true : r.status === filter);

      return (
        <div>
          <PageHead title="Recommendations" desc="Jalur belajar dari hasil gap analysis — kerjakan modul untuk menutup gap." />
          <Section title="Progress belajar">
            <div className="flex flex-wrap gap-2 mb-3">
              <span className="text-xs px-2.5 py-1 rounded-full bg-slate-800 border border-slate-700 text-slate-300">Pending: <b className="text-white">{counts.pending}</b></span>
              <span className="text-xs px-2.5 py-1 rounded-full bg-indigo-900/40 border border-indigo-700 text-indigo-200">Berjalan: <b>{counts['in-progress']}</b></span>
              <span className="text-xs px-2.5 py-1 rounded-full bg-emerald-900/40 border border-emerald-700 text-emerald-200">Selesai: <b>{done}</b></span>
              <span className="text-xs px-2.5 py-1 rounded-full bg-slate-700 text-white">Total: <b>{total}</b></span>
              <button onClick={load} className={BTN2 + ' ml-auto text-xs py-1.5'}>Muat ulang</button>
            </div>
            <div className="w-full h-2 bg-slate-800 rounded-full overflow-hidden mb-2">
              <div className="h-full bg-emerald-500 transition-all" style={{ width: pct + '%' }}></div>
            </div>
            <p className="text-xs text-slate-500">{done} dari {total} selesai — {pct}%</p>
            <div className="flex gap-1.5 mt-3 flex-wrap">
              {['all','pending','in-progress','completed'].map((f) => (
                <button key={f} onClick={() => setFilter(f)} className={'text-xs px-3 py-1.5 rounded-full border transition ' + (filter===f ? 'bg-white text-slate-900 border-white font-semibold shadow' : 'bg-slate-800 border-slate-700 text-slate-300 hover:text-white')}>{f==='all'?'Semua': f==='in-progress'?'Berjalan': f.charAt(0).toUpperCase()+f.slice(1)}</button>
              ))}
            </div>
          </Section>
          {loading && <SkeletonList n={3} />}
          {!loading && filtered.length === 0 && (
            list.length===0
              ? <EmptyState title="Belum ada rekomendasi" hint="Jalankan Gap Analysis dulu (pilih project atau tanpa project untuk pasar aktif). Rekomendasi akan muncul otomatis." action={<button onClick={() => { window.location.hash = HASH.gap; }} className={BTN}>Buka Gap Analysis</button>} />
              : <EmptyState title="Tidak ada di filter ini" hint={'Coba filter "Semua".'} />
          )}
          {!loading && filtered.map((r) => {
            const tm = TYPE_META[r.type] || { icon: '•', label: r.type, color: 'bg-slate-700 text-slate-100' };
            const isOpen = !!expanded[r.id] || r.status === 'in-progress';
            const steps = moduleSteps(r);
            const doneSteps = (checks[r.id] || []).length;
            const allChecked = doneSteps === steps.length && steps.length>0;
            return (
              <div key={r.id} className={'rounded-2xl p-4 mb-3 border ' + (r.status==='completed' ? 'bg-emerald-950/20 border-emerald-800/50' : r.status==='in-progress' ? 'bg-indigo-950/20 border-indigo-800/50' : 'bg-slate-900 border-slate-800')}>
                <div className="flex items-start gap-3">
                  <span className={'shrink-0 text-xs font-bold px-2 py-1 rounded-lg ' + tm.color}>{tm.icon} {tm.label}</span>
                  <div className="flex-1 min-w-0">
                    <p className="text-sm text-slate-100 font-semibold leading-snug">{r.title}</p>
                    <p className="text-xs text-slate-400 mt-0.5">{r.description || ''}</p>
                    <p className="text-xs text-slate-500 mt-1">Sumber: {r.source || '—'} {r.skill_id ? '· Skill #' + r.skill_id : ''}</p>
                  </div>
                  <div className="flex flex-col items-end gap-1 shrink-0">
                    <span className={'text-xs font-bold px-2 py-1 rounded-full ' + (PRIO[r.priority]||'bg-slate-700 text-white')}>{r.priority}</span>
                    <span className={'text-xs px-2 py-0.5 rounded-full border ' + (r.status==='pending'?'bg-slate-800 border-slate-700 text-slate-300': r.status==='in-progress'?'bg-amber-500 text-slate-900 border-amber-600 font-semibold': 'bg-emerald-600 text-white border-emerald-700')}>{r.status}</span>
                  </div>
                </div>
                <div className="flex gap-2 mt-3 flex-wrap">
                  <button onClick={() => setExpanded(Object.assign({}, expanded, { [r.id]: !isOpen }))} className={BTN2 + ' text-xs'}>{isOpen ? 'Tutup Modul' : 'Buka Modul'}</button>
                  {r.status === 'pending' && <button disabled={acting===''+r.id+':start'} onClick={() => { setExpanded(Object.assign({}, expanded, { [r.id]: true })); act(r.id, 'start', 'Mulai'); }} className={BTN + ' text-xs'}>{acting===''+r.id+':start' ? 'Memulai…' : 'Mulai'}</button>}
                  {r.status === 'in-progress' && <button disabled={acting===''+r.id+':completed'} title={allChecked ? '' : 'Centang semua langkah dulu (opsional)'} onClick={() => act(r.id, 'completed', 'Selesai')} className={BTN + ' text-xs'}>{acting===''+r.id+':completed' ? 'Menyimpan…' : 'Tandai Selesai'}</button>}
                  {r.status === 'completed' && <span className="inline-flex items-center gap-1 text-xs text-emerald-300 bg-emerald-950/40 border border-emerald-800 px-2.5 py-1 rounded-full">✓ Selesai {r.consumed_at ? '· ' + new Date(r.consumed_at).toLocaleDateString('id-ID') : ''}</span>}
                </div>
                {isOpen && (
                  <div className="mt-3 rounded-xl bg-slate-950 border border-slate-800 p-3">
                    <p className="text-xs font-semibold text-slate-200 mb-2">Modul belajar — {steps.length} langkah {r.status==='in-progress' ? '(' + doneSteps + '/' + steps.length + ')' : ''}</p>
                    <div className="space-y-1.5">
                      {steps.map((s) => {
                        const checked = (checks[r.id]||[]).includes(s.id);
                        return (
                          <label key={s.id} className={'flex items-start gap-2 rounded-lg px-2.5 py-2 cursor-pointer transition ' + (checked ? 'bg-emerald-950/30 border border-emerald-800/40' : 'bg-slate-900 border border-slate-800 hover:border-slate-700')}>
                            <input type="checkbox" checked={checked} onChange={(e) => {
                              const cur = checks[r.id] || [];
                              const next = e.target.checked ? cur.concat([s.id]) : cur.filter((x)=> x!==s.id);
                              setChecks(Object.assign({}, checks, { [r.id]: next }));
                            }} className="mt-0.5 rounded border-slate-600 bg-slate-800 text-indigo-600 focus:ring-indigo-500" />
                            <span className="flex-1 min-w-0">
                              <span className={'text-xs font-medium ' + (checked ? 'text-emerald-200 line-through' : 'text-slate-200')}>{s.t}</span>
                              <span className="text-xs text-slate-500 block">{s.d}</span>
                            </span>
                          </label>
                        );
                      })}
                    </div>
                    {r.status === 'pending' && <p className="text-xs text-slate-500 mt-2">Klik <b>Mulai</b> untuk mengubah status jadi berjalan, lalu centang langkah saat mengerjakan.</p>}
                    {r.status === 'in-progress' && !allChecked && <p className="text-xs text-amber-300 mt-2">Centang langkah yang sudah dikerjakan, lalu klik <b>Tandai Selesai</b>.</p>}
                    {allChecked && r.status === 'in-progress' && <p className="text-xs text-emerald-300 mt-2">Semua langkah selesai — silakan Tandai Selesai.</p>}
                    <p className="text-xs text-slate-500 mt-2">Estimasi: {r.type==='course'?'1–4 minggu': r.type==='workshop'?'1–2 minggu': r.type==='certification'?'1–3 bulan': r.type==='practice-project'?'2–3 minggu':'4 sesi'} · {r.source}</p>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      );
    }

    // ---- Halaman: My Projects (perusahaan) ----
    function MyProjectsView(props) {
      const [list, setList] = useState([]);
      const [loading, setLoading] = useState(true);
      const [tax, setTax] = useState([]);
      const [form, setForm] = useState({ judul: '', sektor_industri: '', deadline: '', difficulty: 'medium', status: 'active' });
      const [rows, setRows] = useState([{ skill_id: '', level_required: 50 }]);
      const [editId, setEditId] = useState(null);
      const [edit, setEdit] = useState({ judul: '', deskripsi: '', status: 'active' });
      const [pendingDel, setPendingDel] = useState(null);
      const [msg, setMsg] = useState('');
      const [isErr, setIsErr] = useState(false);
      async function load() {
        setLoading(true);
        try {
          const j = await apiFetch('/companies/projects', props.token);
          setList(j.data.projects || []);
          const t = await apiFetch('/skills', props.token).catch(() => ({ data: { skills: [] } }));
          setTax(t.data.skills || []);
        } catch (e) { if (e.code === 401) props.onExpire(); else props.notify(e.message, true); }
        finally { setLoading(false); }
      }
      useEffect(() => { load(); }, []);
      function setF(k, v) { setForm(Object.assign({}, form, { [k]: v })); }
      async function create() {
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/companies/projects', props.token, 'POST', {
            judul: form.judul, sektor_industri: form.sektor_industri || undefined,
            deadline: form.deadline || undefined, difficulty: form.difficulty, status: form.status,
            skills: rows.filter((x) => x.skill_id).map((x) => ({ skill_id: Number(x.skill_id), level_required: Number(x.level_required) })),
          });
          setForm({ judul: '', sektor_industri: '', deadline: '', difficulty: 'medium', status: 'active' });
          setRows([{ skill_id: '', level_required: 50 }]);
          props.notify('Project dibuat.'); load();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      async function save(id) {
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/companies/projects/' + id, props.token, 'PUT', { judul: edit.judul || undefined, deskripsi: edit.deskripsi || undefined, status: edit.status });
          setEditId(null); props.notify('Project diupdate.'); load();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      async function del(id) {
        setPendingDel(null);
        try { await apiSend('/companies/projects/' + id, props.token, 'DELETE'); props.notify('Project dihapus.'); load(); }
        catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      return (
        <div>
          <PageHead title="My Projects" desc="Buat dan kelola project perusahaan." />
          <Msg text={msg} err={isErr} />
          <Section title="Buat Project">
            <input value={form.judul} onChange={(e) => setF('judul', e.target.value)} placeholder="Judul (min 5 karakter)" className={INP} />
            <div className="flex flex-wrap gap-2 mb-2">
              <input value={form.sektor_industri} onChange={(e) => setF('sektor_industri', e.target.value)} placeholder="Sektor" className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm" />
              <input type="date" value={form.deadline} onChange={(e) => setF('deadline', e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm" />
              <select value={form.difficulty} onChange={(e) => setF('difficulty', e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
                <option value="easy">easy</option><option value="medium">medium</option><option value="hard">hard</option>
              </select>
              <select value={form.status} onChange={(e) => setF('status', e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
                <option value="active">active</option><option value="draft">draft</option>
              </select>
            </div>
            {rows.map((row, i) => (
              <div key={i} className="flex gap-2 mb-2">
                <select value={row.skill_id} onChange={(e) => { const c = rows.slice(); c[i].skill_id = e.target.value; setRows(c); }} className="flex-1 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
                  <option value="">— pilih skill —</option>
                  {tax.map((s) => <option key={s.id} value={s.id}>{s.name}</option>)}
                </select>
                <input type="number" min="0" max="100" value={row.level_required} onChange={(e) => { const c = rows.slice(); c[i].level_required = e.target.value; setRows(c); }} className="w-20 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm" />
                <button onClick={() => setRows(rows.filter((_, j) => j !== i))} aria-label="Hapus baris skill" className={BTN2}>×</button>
              </div>
            ))}
            <div className="flex gap-2">
              <button onClick={() => setRows(rows.concat([{ skill_id: '', level_required: 50 }]))} className={BTN2}>+ Skill</button>
              <button onClick={create} className={BTN}>Buat Project</button>
            </div>
          </Section>
          <Section title={'Project Saya (' + list.length + ')'}>
            {loading && <SkeletonList n={3} />}
            {!loading && list.length === 0 && <EmptyState title="Belum ada project" hint="Buat project pertama dari form di atas." />}
            {!loading && list.map((p) => (
              <div key={p.id} className="py-2 border-b border-slate-800 last:border-0">
                <div className="flex items-center gap-2">
                  <span className="flex-1 text-sm text-slate-200">{p.judul} <span className="text-slate-500">[{p.status} · {p.difficulty || '–'} · {p.deadline || '–'}]</span></span>
                  <button onClick={() => { setEditId(p.id); setEdit({ judul: p.judul, deskripsi: p.deskripsi || '', status: p.status }); }} className={BTN2}>Edit</button>
                  <button onClick={() => setPendingDel(p.id)} className={DANGER}>Hapus</button>
                </div>
                {editId === p.id && (
                  <div className="mt-2">
                    <input value={edit.judul} onChange={(e) => setEdit(Object.assign({}, edit, { judul: e.target.value }))} className={INP} />
                    <input value={edit.deskripsi} onChange={(e) => setEdit(Object.assign({}, edit, { deskripsi: e.target.value }))} placeholder="Deskripsi" className={INP} />
                    <div className="flex gap-2">
                      <select value={edit.status} onChange={(e) => setEdit(Object.assign({}, edit, { status: e.target.value }))} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
                        <option value="draft">draft</option><option value="active">active</option><option value="closed">closed</option>
                      </select>
                      <button onClick={() => save(p.id)} className={BTN}>Simpan</button>
                      <button onClick={() => setEditId(null)} className={BTN2}>Batal</button>
                    </div>
                  </div>
                )}
              </div>
            ))}
          </Section>
          <ConfirmModal open={pendingDel != null} title="Hapus project?" text="Project terhapus (soft-delete) beserta datanya." onCancel={() => setPendingDel(null)} onConfirm={() => del(pendingDel)} />
        </div>
      );
    }

    // ---- Halaman: Applications — Talent Matching + Ranking + Evaluasi (perusahaan) ----
    function ApplicationsView(props) {
      const lang = props.lang || 'id';
      const [projects, setProjects] = useState([]);
      const [pid, setPid] = useState('');
      const [ranked, setRanked] = useState([]);
      const [accepted, setAccepted] = useState([]);
      const [loading, setLoading] = useState(true);
      const [msg, setMsg] = useState('');
      const [q, setQ] = useState('');
      const [expanded, setExpanded] = useState(null);
      const [closing, setClosing] = useState(false);
      const [evalOpen, setEvalOpen] = useState(false);
      const [evalTarget, setEvalTarget] = useState({ project: null, student: null });
      useEffect(() => {
        apiFetch('/companies/projects', props.token)
          .then((j) => {
            const arr = j.data.projects || [];
            setProjects(arr);
            if (arr.length > 0) { setPid(String(arr[0].id)); loadAll(arr[0].id); }
            else setLoading(false);
          })
          .catch((e) => { if (e.code === 401) props.onExpire(); else setLoading(false); });
      }, []);
      async function loadAll(id) {
        setLoading(true); setMsg('');
        try {
          const [r, a] = await Promise.all([
            apiFetch('/companies/candidates?project_id=' + id, props.token).catch(()=> ({ data:{candidates:[]} })),
            apiFetch('/companies/projects/' + id + '/applications', props.token).catch(()=> ({ data:{applications:[]} })),
          ]);
          const cand = r.data.candidates || r.data.candidates === undefined ? (r.data.candidates || []) : [];
          // Fallback: bila endpoint candidates kosong tapi aplikasi pending ada (mis. belum ter-rank), hitung dari applications
          let pendingRanked = cand;
          if (pendingRanked.length === 0) {
            const pend = (a.data.applications || []).filter(x=> x.status==='pending');
            // Jika pending punya match_score (sudah dihitung backend dashboard), pakai itu untuk urut
            pendingRanked = pend.map(p=> ({ application_id: p.id, student: { id: p.student_id, name: p.student_name, email: p.student_email }, match_score: p.match_score, components: null, breakdown: null, skills: (p.skills||[]).map(s=>s.name), applied_at: p.applied_at, cover_letter: p.cover_letter, status: p.status, project_id: p.project_id }));
            pendingRanked.sort((x,y)=> (y.match_score??-1)-(x.match_score??-1));
          }
          setRanked(pendingRanked);
          const acc = (a.data.applications || []).filter(x=> x.status==='accepted');
          setAccepted(acc);
        } catch (e) { if (e.code === 401) props.onExpire(); else props.notify(e.message, true); }
        finally { setLoading(false); }
      }
      async function decide(id, status) {
        try {
          await apiSend('/companies/applications/' + id, props.token, 'PATCH', { status });
          props.notify('Aplikasi ' + status + '.'); loadAll(pid); if (props.onRefresh) props.onRefresh();
        } catch (e) { if (e.code === 401) props.onExpire(); else setMsg(e.message); }
      }
      async function closeProject() {
        const proj = projects.find(p=> String(p.id)===String(pid));
        if(!proj) return;
        setClosing(true);
        try {
          await apiSend('/companies/projects/' + proj.id, props.token, 'PUT', { status: 'closed' });
          props.notify('Project ditutup — kini bisa menilai.');
          const j = await apiFetch('/companies/projects', props.token);
          setProjects(j.data.projects || []);
          loadAll(pid);
        } catch(e){ if(e.code===401) props.onExpire(); else setMsg(e.message); }
        finally{ setClosing(false); }
      }
      function openEval(project, student){
        setEvalTarget({ project, student });
        setEvalOpen(true);
      }
      async function submitEval(payload){
        const proj = evalTarget.project;
        if (proj && proj.status !== 'closed') {
          try { await apiSend('/companies/projects/' + proj.id, props.token, 'PUT', { status: 'closed' }); } catch(e){}
        }
        await saveAssessment(payload, props.token);
        props.notify('Penilaian tersimpan — skill mahasiswa terupdate.');
        setEvalOpen(false);
        loadAll(pid);
        // refresh projects list untuk status closed
        try { const j = await apiFetch('/companies/projects', props.token); setProjects(j.data.projects || []); } catch(e){}
      }
      const curProj = projects.find(p=> String(p.id)===String(pid));
      const needle = q.trim().toLowerCase();
      const filteredRanked = ranked.filter(c=>{
        if(!needle) return true;
        return (c.student.name||'').toLowerCase().includes(needle) || (c.student.email||'').toLowerCase().includes(needle) || (c.skills||[]).join(' ').toLowerCase().includes(needle);
      });
      const isClosed = curProj && curProj.status === 'closed';
      return (
        <div>
          <PageHead title={tr(lang,'nav_apps')} desc={tr(lang,'ranking_desc')} />
          {msg && <p className="text-sm text-red-400 bg-red-950/30 border border-red-800 rounded-lg px-3 py-2 mb-3">{msg}</p>}
          <div className="flex flex-wrap gap-2 mb-3 items-center">
            <select value={pid} onChange={(e) => { setPid(e.target.value); loadAll(e.target.value); }} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-2 text-sm min-w-48">
              {projects.map((p) => <option key={p.id} value={p.id}>{p.judul} [{p.status}]</option>)}
            </select>
            <SearchInput value={q} onSearch={setQ} placeholder={tr(lang,'search_candidates')} lang={lang} />
            {curProj && <span className="text-xs text-slate-500">{curProj.judul} · {filteredRanked.length} kandidat</span>}
          </div>

          <Section title={'Talent Matching — Ranking (' + filteredRanked.length + ')'} >
            {loading && <SkeletonList n={3} />}
            {!loading && filteredRanked.length === 0 && <EmptyState title="Belum ada kandidat pending" hint="Bagikan project agar mahasiswa mendaftar. Kandidat akan terurut otomatis 50/20/10/10/10." />}
            {!loading && filteredRanked.map((c, idx)=> {
              const isFirst = idx===0, isSecond = idx===1, isThird = idx===2;
              const rankBadge = isFirst ? '🥇' : isSecond ? '🥈' : isThird ? '🥉' : '#' + (idx+1);
              return (
                <div key={c.application_id} className={'rounded-2xl p-4 mb-3 border ' + (isFirst ? 'bg-gradient-to-br from-indigo-950/40 to-slate-900 border-indigo-700/40' : 'bg-slate-900 border-slate-800')}>
                  <div className="flex items-start gap-3">
                    <span className="text-sm font-bold text-slate-400 w-8 text-center pt-1">{rankBadge}</span>
                    <div className="flex-1 min-w-0">
                      <p className="text-sm text-slate-100 font-semibold truncate">{c.student.name} <span className="text-xs text-slate-500 font-normal">· {c.student.email}</span></p>
                      <p className="text-xs text-slate-500 truncate">{(c.skills||[]).join(', ') || '—'}</p>
                      {c.cover_letter && <p className="text-xs text-slate-400 mt-1 line-clamp-2">“{c.cover_letter}”</p>}
                      {expanded===c.application_id && c.breakdown && (
                        <div className="mt-3">
                          <div className="grid grid-cols-3 gap-1.5 mb-2">
                            {c.components && Object.entries(c.components).map(([k,v])=> (
                              <div key={k} className="bg-slate-800 rounded-lg px-2 py-1.5 text-center"><div className="text-xs text-slate-500">{k}</div><div className="text-sm font-bold text-white">{v}</div></div>
                            ))}
                          </div>
                          <table className="w-full text-xs">
                            <thead><tr className="text-slate-500"><th className="text-left py-1">Skill</th><th>Butuh</th><th>Saya</th><th>Gap</th><th>Status</th></tr></thead>
                            <tbody>{c.breakdown.map(b=> (<tr key={b.skill_id} className="border-t border-slate-800"><td className="py-1 text-slate-200">{b.name}</td><td className="text-center">{b.required}</td><td className="text-center">{b.current}</td><td className="text-center font-bold">{b.gap}</td><td><span className={'text-xs px-1.5 py-0.5 rounded ' + (b.status==='kuat'?'bg-emerald-600 text-white': b.status==='close'?'bg-amber-500 text-slate-900':'bg-red-600 text-white')}>{b.status}</span></td></tr>))}</tbody>
                          </table>
                        </div>
                      )}
                      {expanded===c.application_id && !c.breakdown && <p className="text-xs text-slate-500 mt-2">Breakdown tidak tersedia — buka Candidates API untuk detail lengkap.</p>}
                    </div>
                    <div className="flex flex-col items-end gap-1 shrink-0">
                      <span className={'text-sm font-extrabold px-2.5 py-1 rounded-lg ' + matchColor(c.match_score)}>{c.match_score ?? '—'}</span>
                      {c.breakdown && <button onClick={()=> setExpanded(expanded===c.application_id ? null : c.application_id)} className="text-xs text-indigo-400 hover:text-indigo-300">{expanded===c.application_id ? 'Tutup' : 'Breakdown'}</button>}
                      <span className="text-xs text-slate-500">{c.applied_at ? new Date(c.applied_at).toLocaleDateString('id-ID') : ''}</span>
                    </div>
                  </div>
                  <div className="flex gap-2 mt-3">
                    <button onClick={() => decide(c.application_id, 'accepted')} className={BTN}>Terima</button>
                    <button onClick={() => decide(c.application_id, 'rejected')} className={DANGER}>Tolak</button>
                  </div>
                </div>
              );
            })}
          </Section>

          <Section title={'Siap Dinilai (' + accepted.length + ') — Evaluasi'}>
            {!isClosed && accepted.length>0 && (
              <div className="bg-amber-950/30 border border-amber-800 rounded-xl px-3 py-2 mb-3 flex items-center gap-2">
                <span className="text-amber-400 text-sm">Project masih {curProj?.status}. Tutup project terlebih dahulu agar bisa menilai (syarat: status closed).</span>
                <button onClick={closeProject} disabled={closing} className={BTN2 + ' ml-auto'}>{closing ? 'Menutup...' : 'Tutup Project'}</button>
              </div>
            )}
            {isClosed && accepted.length>0 && <p className="text-xs text-emerald-400 mb-2">Project sudah closed — silakan nilai kandidat accepted.</p>}
            {accepted.length===0 && <EmptyState title="Belum ada yang diterima" hint="Terima kandidat di Ranking atas, lalu nilai di sini setelah project closed." />}
            {accepted.map((a)=> {
              const projForEval = projects.find(p=> p.id===a.project_id) || curProj;
              return (
              <div key={a.id} className="bg-slate-800/50 border border-slate-700 rounded-xl p-3 mb-2 flex items-center gap-3">
                <span className="flex-1 text-sm text-slate-200">{a.student_name} <span className="text-xs text-slate-500">· {a.student_email}</span></span>
                <button onClick={() => openEval(projForEval, { id: a.student_id, name: a.student_name, email: a.student_email })} className={BTN}>Nilai</button>
              </div>
              );
            })}
          </Section>
          {evalOpen && <EvaluateModal open={evalOpen} project={evalTarget.project} student={evalTarget.student} onClose={()=> setEvalOpen(false)} onSubmit={submitEval} />}
        </div>
      );
    }

    // ---- Halaman: Assess — dedicated hub (perusahaan: semua accepted, dosen: awaiting) ----
    function AssessView(props) {
      const t = props.target || {};
      const [list, setList] = useState([]);
      const [loading, setLoading] = useState(true);
      const [msg, setMsg] = useState('');
      const [evalOpen, setEvalOpen] = useState(false);
      const [evalTarget, setEvalTarget] = useState({ project: null, student: null });
      useEffect(()=> {
        if (t.project_id && t.student_id) {
          const proj = { id: t.project_id, judul: 'Project #' + t.project_id, status: 'closed' };
          const stud = { id: t.student_id, name: 'Mahasiswa #' + t.student_id };
          setEvalTarget({ project: proj, student: stud });
          setEvalOpen(true);
        }
      }, [t.project_id, t.student_id]);
      async function load(){
        setLoading(true);
        try {
          const me = await apiFetch('/auth/me', props.token).catch(()=> null);
          const role = me && me.data && me.data.user ? me.data.user.role : 'perusahaan';
          if (role === 'dosen') {
            const j = await apiFetch('/mentor/awaiting', props.token);
            const arr = j.data.awaiting || [];
            setList(arr.map(x=> ({ project_id: x.project_id, project_judul: x.project_judul, student_id: x.student_id, student_name: x.student_name, assessed: !!x.assessed })));
          } else {
            const pj = await apiFetch('/companies/projects', props.token);
            const projs = pj.data.projects || [];
            let all = [];
            for (const p of projs) {
              const aj = await apiFetch('/companies/projects/' + p.id + '/applications', props.token).catch(()=> ({data:{applications:[]}}));
              const acc = (aj.data.applications || []).filter(a=> a.status==='accepted');
              for (const a of acc) all.push({ project_id: p.id, project_judul: p.judul, project_status: p.status, student_id: a.student_id, student_name: a.student_name, student_email: a.student_email, application_id: a.id });
            }
            setList(all);
          }
        } catch(e){ if(e.code===401) props.onExpire(); else setMsg(e.message); }
        finally{ setLoading(false); }
      }
      useEffect(()=> { load(); }, []);
      function openEval(item){
        const proj = { id: item.project_id, judul: item.project_judul, status: item.project_status || 'closed' };
        const stud = { id: item.student_id, name: item.student_name, email: item.student_email };
        setEvalTarget({ project: proj, student: stud });
        setEvalOpen(true);
      }
      async function submitEval(payload){
        const proj = evalTarget.project;
        if (proj && proj.status !== 'closed' && proj.status !== undefined) {
          try { await apiSend('/companies/projects/' + proj.id, props.token, 'PUT', { status: 'closed' }); } catch(e){}
        }
        await saveAssessment(payload, props.token);
        props.notify('Penilaian tersimpan — skill terupdate.');
        setEvalOpen(false);
        load();
        if (props.onRefresh) props.onRefresh();
      }
      return (
        <div>
          <PageHead title="Evaluasi" desc="Fitur khusus evaluasi — nilai mahasiswa accepted. Otomatis tutup project bila belum closed, lalu bump skill." />
          {msg && <p className="text-sm text-red-400 bg-red-950/30 border border-red-800 rounded-lg px-3 py-2 mb-3">{msg}</p>}
          <Section title={'Antrian Evaluasi (' + list.length + ')'}>
            {loading && <SkeletonList n={4} />}
            {!loading && list.length===0 && <EmptyState title="Tidak ada yang perlu dinilai" hint="Terima pelamar di Applications, lalu nilai di sini." action={<button onClick={load} className={BTN2}>Muat ulang</button>} />}
            {!loading && list.map((it, idx)=> (
              <div key={idx} className="flex items-center gap-3 py-2 border-b border-slate-800 last:border-0">
                <span className="flex-1 text-sm text-slate-200">{it.student_name || ('Mahasiswa #'+it.student_id)} <span className="text-slate-500">· {it.project_judul || ('Project #'+it.project_id)}</span> {it.assessed ? <span className="text-xs bg-slate-700 text-slate-300 px-1.5 py-0.5 rounded">sudah dinilai</span> : null}</span>
                <button onClick={()=> openEval(it)} className={BTN}>Nilai</button>
              </div>
            ))}
          </Section>
          <Section title="Nilai Manual (by ID)">
            <p className="text-xs text-slate-500 mb-2">Jika tidak ada di antrian, isi ID manual di bawah — akan dibuka via modal yang sama.</p>
            <ManualAssessInline token={props.token} onExpire={props.onExpire} notify={props.notify} onDone={load} onRefresh={props.onRefresh} />
          </Section>
          {evalOpen && <EvaluateModal open={evalOpen} project={evalTarget.project} student={evalTarget.student} onClose={()=> setEvalOpen(false)} onSubmit={submitEval} />}
        </div>
      );
    }
    function ManualAssessInline(props){
      const [pid, setPid] = useState('');
      const [sid, setSid] = useState('');
      const [open, setOpen] = useState(false);
      const [target, setTarget] = useState(null);
      function go(){
        if(!pid || !sid) return;
        setTarget({ project: { id: Number(pid), judul: 'Project #'+pid, status: 'closed' }, student: { id: Number(sid), name: 'Mahasiswa #'+sid } });
        setOpen(true);
      }
      async function submit(payload){
        try { await apiSend('/companies/projects/' + payload.project_id, props.token, 'PUT', { status: 'closed' }); } catch(e){}
        await saveAssessment(payload, props.token);
        props.notify('Penilaian manual tersimpan.');
        setOpen(false);
        if(props.onDone) props.onDone();
        if(props.onRefresh) props.onRefresh();
      }
      return (
        <div>
          <div className="flex gap-2 mb-2">
            <input value={pid} onChange={(e)=> setPid(e.target.value)} placeholder="project_id" className="w-28 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm" />
            <input value={sid} onChange={(e)=> setSid(e.target.value)} placeholder="student_id" className="w-28 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm" />
            <button onClick={go} className={BTN2}>Buka Form</button>
          </div>
          {open && <EvaluateModal open={open} project={target.project} student={target.student} onClose={()=> setOpen(false)} onSubmit={submit} />}
        </div>
      );
    }

    // ---- Halaman: Assess list (dosen) ----
    function MentorView(props) {
      const [list, setList] = useState([]);
      const [loading, setLoading] = useState(true);
      useEffect(() => {
        apiFetch('/mentor/awaiting', props.token)
          .then((j) => setList(j.data.awaiting || []))
          .catch((e) => { if (e.code === 401) props.onExpire(); })
          .finally(() => setLoading(false));
      }, []);
      return (
        <div>
          <PageHead title="Antrian Penilaian" desc="Aplikasi accepted yang bisa dinilai." />
          {loading && <SkeletonList n={3} />}
          {!loading && list.length === 0 && <EmptyState title="Tidak ada aplikasi accepted" />}
          {!loading && list.map((a, i) => (
            <div key={i} className="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-2 flex items-center gap-3">
              <span className="flex-1 text-sm text-slate-200">{a.student_name} <span className="text-slate-500">· {a.project_judul} {a.assessed ? '[sudah dinilai]' : '[belum dinilai]'}</span></span>
              <button onClick={() => props.onAssess({ project_id: a.project_id, student_id: a.student_id })} className={BTN2}>Nilai</button>
            </div>
          ))}
        </div>
      );
    }

    // ---- Halaman: Notifikasi (semua role) ----
    function NotifsView(props) {
      const [list, setList] = useState([]);
      const [loading, setLoading] = useState(true);
      const [unreadOnly, setUnreadOnly] = useState(false);
      async function load(uo) {
        setLoading(true);
        try {
          const j = await apiFetch('/notifications' + (uo ? '?is_read=0' : ''), props.token);
          setList(j.data.notifications || []);
        } catch (e) { if (e.code === 401) props.onExpire(); else props.notify(e.message, true); }
        finally { setLoading(false); }
      }
      useEffect(() => { load(unreadOnly); }, [unreadOnly]);
      async function mark(id) {
        try {
          await apiSend('/notifications/' + id + '/read', props.token, 'PUT');
          load(unreadOnly);
        } catch (e) { if (e.code === 401) props.onExpire(); else props.notify(e.message, true); }
      }
      return (
        <div>
          <PageHead title="Notifikasi" desc="Semua pemberitahuan akun." action={
            <label className="inline-flex items-center gap-1.5 text-xs text-slate-400 cursor-pointer"><input type="checkbox" checked={unreadOnly} onChange={(e) => setUnreadOnly(e.target.checked)} className="rounded border-slate-600 bg-slate-800" /> Belum dibaca saja</label>
          } />
          {loading && <SkeletonList />}
          {!loading && list.length === 0 && <EmptyState title="Tidak ada notifikasi" />}
          {!loading && list.map((n) => (
            <div key={n.id} className="bg-slate-900 border border-slate-800 rounded-2xl p-3 mb-2 flex items-center gap-3">
              <p className="flex-1 text-sm text-slate-300"><span className="text-indigo-400">[{n.type}]</span> {n.content}</p>
              {!n.is_read && <button onClick={() => mark(n.id)} className={BTN2}>Tandai dibaca</button>}
            </div>
          ))}
        </div>
      );
    }

    // ---- Halaman: Profil (semua role) ----
    function ProfileView(props) {
      const [data, setData] = useState(null);
      const [f, setF] = useState({});
      const [msg, setMsg] = useState('');
      const [isErr, setIsErr] = useState(false);
      async function load() {
        try {
          const j = await apiFetch('/users/profile', props.token);
          setData(j.data); setF(Object.assign({ name: j.data.user.name }, j.data.profile || {}));
        } catch (e) { if (e.code === 401) props.onExpire(); else props.notify(e.message, true); }
      }
      useEffect(() => { load(); }, []);
      function set(k, v) { setF(Object.assign({}, f, { [k]: v })); }
      async function save() {
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/users/profile', props.token, 'PUT', f);
          props.notify('Profil diupdate.'); load();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      if (!data) return <SkeletonList n={4} />;
      const role = data.user.role;
      return (
        <div>
          <PageHead title="Profil" desc={data.user.email + ' · ' + role} />
          <Msg text={msg} err={isErr} />
          <Section title={data.user.name}>
            <label className="block text-xs text-slate-400 mb-1">Nama</label>
            <input value={f.name || ''} onChange={(e) => set('name', e.target.value)} className={INP} />
            {role === 'mahasiswa' && (
              <div>
                <div className="flex gap-2">
                  <input value={f.npm || ''} onChange={(e) => set('npm', e.target.value)} placeholder="NPM (8 karakter)" className={INP} />
                  <input value={f.angkatan || ''} onChange={(e) => set('angkatan', e.target.value)} placeholder="Angkatan" className={INP} />
                </div>
                <input value={f.program_studi || ''} onChange={(e) => set('program_studi', e.target.value)} placeholder="Program studi" className={INP} />
                <textarea value={f.bio || ''} onChange={(e) => set('bio', e.target.value)} placeholder="Bio" rows="2" className={INP}></textarea>
              </div>
            )}
            {role === 'perusahaan' && (
              <div>
                <input value={f.nama_perusahaan || ''} onChange={(e) => set('nama_perusahaan', e.target.value)} placeholder="Nama perusahaan" className={INP} />
                <div className="flex gap-2">
                  <input value={f.industri || ''} onChange={(e) => set('industri', e.target.value)} placeholder="Industri" className={INP} />
                  <select value={f.size || 'medium'} onChange={(e) => set('size', e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-2 mb-2 text-sm">
                    <option value="startup">startup</option><option value="medium">medium</option><option value="large">large</option><option value="corporate">corporate</option>
                  </select>
                </div>
                <textarea value={f.deskripsi || ''} onChange={(e) => set('deskripsi', e.target.value)} placeholder="Deskripsi" rows="2" className={INP}></textarea>
              </div>
            )}
            <button onClick={save} className={BTN}>Simpan</button>
          </Section>
        </div>
      );
    }

    const NAV = {
      mahasiswa: [['dash', 'Dashboard'], ['projects', 'Projects'], ['skills', 'My Skills'], ['gap', 'Gap Analysis'], ['recs', 'Recommendations'], ['notifs', 'Notifikasi'], ['profile', 'Profil']],
      perusahaan: [['dash', 'Dashboard'], ['myprojects', 'My Projects'], ['applications', 'Applications'], ['assess', 'Assess'], ['notifs', 'Notifikasi'], ['profile', 'Profil']],
      kampus: [['dash', 'Dashboard'], ['analytics', 'Analytics'], ['notifs', 'Notifikasi'], ['profile', 'Profil']],
      dosen: [['dash', 'Dashboard'], ['analytics', 'Analytics'], ['assess', 'Assess'], ['notifs', 'Notifikasi'], ['profile', 'Profil']],
    };
    const TITLES = {
      dash: null, analytics: 'Analytics', projects: 'Projects', skills: 'My Skills', gap: 'Gap Analysis',
      recs: 'Recommendations', myprojects: 'My Projects', applications: 'Applications', assess: 'Assess',
      notifs: 'Notifikasi', profile: 'Profil',
    };
    const ROLE_TITLES = { mahasiswa: 'Dashboard Mahasiswa', perusahaan: 'Dashboard Perusahaan', kampus: 'Dashboard Kampus', dosen: 'Dashboard Kampus (Dosen)' };

    function App() {
      const [token, setToken] = useState(localStorage.getItem('token') || '');
      const [user, setUser] = useState(null);
      const [data, setData] = useState(null);
      const [view, setView] = useState(viewFromHash());
      const [assessTarget, setAssessTarget] = useState({});
      const [err, setErr] = useState('');
      const [loading, setLoading] = useState(false);
      const [toasts, setToasts] = useState([]);
      const [lang, setLang] = useState(localStorage.getItem('app_lang') || 'id');
      function toggleLang(){ const n = lang==='id' ? 'en' : 'id'; setLang(n); localStorage.setItem('app_lang', n); }

      function notify(text, isErr) {
        const id = Date.now() + Math.random();
        setToasts((t) => t.concat([{ id, text, err: !!isErr }]));
        setTimeout(() => setToasts((t) => t.filter((x) => x.id !== id)), 3500);
      }
      function navigate(v) {
        setView(v);
        try {
          if (viewFromHash() !== v) window.location.hash = HASH[v] || '#/';
        } catch (ex) { /* abaikan */ }
      }
      useEffect(() => {
        function onHash() { setView(viewFromHash()); }
        window.addEventListener('hashchange', onHash);
        return () => window.removeEventListener('hashchange', onHash);
      }, []);
      useEffect(() => {
        document.title = ((view === 'dash' && user ? (ROLE_TITLES[user.role] || 'Dashboard') : (TITLES[view] || view)) + ' — Talent Hub');
      }, [view, user]);

      function logout(expireMsg) {
        if (token) { fetch(API + '/auth/logout', { method: 'POST', headers: { Authorization: 'Bearer ' + token } }).catch(() => {}); }
        localStorage.removeItem('token');
        setToken(''); setUser(null); setData(null); setView('dash');
        try { window.location.hash = '#/'; } catch (ex) { /* abaikan */ }
        if (expireMsg) setErr(expireMsg);
      }
      function endpointFor(role) {
        if (role === 'mahasiswa') return '/students/dashboard';
        if (role === 'perusahaan') return '/companies/dashboard';
        return '/campus/dashboard'; // kampus + dosen (RBAC route mengizinkan keduanya)
      }
      async function load(tk) {
        setLoading(true); setErr('');
        try {
          const me = await apiFetch('/auth/me', tk);
          const role = me.data.user.role;
          setUser(me.data.user);
          const dash = await apiFetch(endpointFor(role), tk);
          setData(dash.data);
        } catch (e) {
          if (e.code === 401) { logout('Sesi berakhir, silakan login ulang.'); }
          else setErr(e.message);
        } finally { setLoading(false); }
      }
      async function refreshDash(){
        if (!token || !user) return;
        try {
          const dash = await apiFetch(endpointFor(user.role), token);
          setData(dash.data);
        } catch (e) { if (e.code === 401) logout(lang==='en' ? 'Session expired, please login again.' : 'Sesi berakhir, silakan login ulang.'); }
      }
      useEffect(() => { if (token) load(token); }, []);
      useEffect(() => { if (view === 'dash' && token && user) refreshDash(); }, [view]);
      function onLogin(tk, usr) {
        localStorage.setItem('token', tk);
        setToken(tk); setUser(usr); navigate('dash');
        load(tk);
      }
      function goAssess(t) { setAssessTarget(t || {}); navigate('assess'); }

      if (!token || !user) return (<div><LoginView onLogin={onLogin} lang={lang} onToggleLang={toggleLang} /><Toasts items={toasts} /></div>);
      const nav = NAV[user.role] || NAV.mahasiswa;
      const canAnalytics = user.role === 'kampus' || user.role === 'dosen';
      const expire = () => logout(lang==='en' ? 'Session expired, please login again.' : 'Sesi berakhir, silakan login ulang.');
      const i18nNav = { dash: 'nav_dash', projects: 'nav_projects', skills: 'nav_skills', gap: 'nav_gap', recs: 'nav_recs', myprojects: 'nav_myprojects', applications: 'nav_apps', assess: 'nav_assess', analytics: 'nav_analytics', notifs: 'nav_notifs', profile: 'nav_profile' };
      return (
        <div className="min-h-screen bg-slate-950 text-slate-200 flex flex-col md:flex-row">
          <aside className="hidden md:flex w-52 shrink-0 bg-slate-900 border-r border-slate-800 p-4 flex-col">
            <p className="font-bold text-white text-sm mb-1">Talent Hub App</p>
            <p className="text-xs text-slate-500 mb-2">{user.name} · {user.role}</p>
            <div className="flex items-center bg-slate-800 border border-slate-700 rounded-full p-1 mb-3 self-start gap-1">
              <button onClick={()=>{ if(lang!=='id'){setLang('id'); localStorage.setItem('app_lang','id');} }} className={'text-xs font-bold px-2.5 py-1 rounded-full transition ' + (lang==='id' ? 'bg-white text-slate-900 shadow' : 'text-slate-400 hover:text-white')}>ID</button>
              <button onClick={()=>{ if(lang!=='en'){setLang('en'); localStorage.setItem('app_lang','en');} }} className={'text-xs font-bold px-2.5 py-1 rounded-full transition ' + (lang==='en' ? 'bg-white text-slate-900 shadow' : 'text-slate-400 hover:text-white')}>EN</button>
            </div>
            {nav.map((n) => (
              <a key={n[0]} href={HASH[n[0]]} onClick={(e) => { e.preventDefault(); navigate(n[0]); }}
                className={'text-left text-sm rounded-lg px-3 py-2 mb-1 transition ' + (view === n[0] ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800')}>{tr(lang, i18nNav[n[0]] || n[0])}</a>
            ))}
            <div className="flex-1"></div>
            <a href="/" className="text-xs text-slate-500 hover:text-slate-300 px-3 py-1">← Landing</a>
            <button onClick={() => logout()} className="text-left text-sm text-red-400 hover:text-red-300 px-3 py-2">Keluar</button>
          </aside>
          <div className="md:hidden sticky top-0 z-40 bg-slate-900/95 backdrop-blur border-b border-slate-800">
            <div className="flex items-center gap-2 px-3 py-2 overflow-x-auto">
              <span className="text-xs font-bold text-white whitespace-nowrap">Talent Hub</span>
              {nav.map((n) => (
                <a key={n[0]} href={HASH[n[0]]} onClick={(e) => { e.preventDefault(); navigate(n[0]); }}
                  className={'text-xs whitespace-nowrap rounded-lg px-2.5 py-1.5 ' + (view === n[0] ? 'bg-indigo-600 text-white' : 'text-slate-300')}>{tr(lang, i18nNav[n[0]] || n[0])}</a>
              ))}
              <div className="flex items-center bg-slate-800 border border-slate-700 rounded-full p-0.5 ml-1">
                <button onClick={()=>{ if(lang!=='id'){setLang('id'); localStorage.setItem('app_lang','id');} }} className={'text-xs font-bold px-2 py-0.5 rounded-full ' + (lang==='id' ? 'bg-white text-slate-900' : 'text-slate-400')}>ID</button>
                <button onClick={()=>{ if(lang!=='en'){setLang('en'); localStorage.setItem('app_lang','en');} }} className={'text-xs font-bold px-2 py-0.5 rounded-full ' + (lang==='en' ? 'bg-white text-slate-900' : 'text-slate-400')}>EN</button>
              </div>
              <button onClick={() => logout()} className="text-xs text-red-400 whitespace-nowrap px-2">Keluar</button>
            </div>
          </div>
          <main className="flex-1 p-4 md:p-5 max-w-5xl w-full mx-auto">
            {view === 'dash' && <h1 className="text-2xl font-extrabold text-white tracking-tight mb-4">{ROLE_TITLES[user.role] || 'Dashboard'}</h1>}
            {err && <p className="text-sm text-red-400 mb-3">{err}</p>}
            {loading && view === 'dash' && <SkeletonList n={5} />}
            {!loading && data && view === 'dash' && user.role === 'mahasiswa' && <StudentDash data={data} />}
            {!loading && data && view === 'dash' && user.role === 'perusahaan' && <CompanyDash data={data} />}
            {!loading && data && view === 'dash' && (user.role === 'kampus' || user.role === 'dosen') && <CampusDash data={data} />}
            {view === 'analytics' && canAnalytics && <AnalyticsView token={token} notify={notify} onExpire={expire} lang={lang} />}
            {view === 'projects' && <ProjectsView token={token} notify={notify} onExpire={expire} lang={lang} />}
            {view === 'skills' && <SkillsView token={token} notify={notify} onExpire={expire} lang={lang} />}
            {view === 'gap' && <GapView token={token} user={user} notify={notify} onExpire={expire} lang={lang} />}
            {view === 'recs' && <RecsView token={token} user={user} notify={notify} onExpire={expire} lang={lang} />}
            {view === 'myprojects' && <MyProjectsView token={token} notify={notify} onExpire={expire} lang={lang} />}
            {view === 'applications' && <ApplicationsView token={token} notify={notify} onAssess={goAssess} onExpire={expire} lang={lang} onRefresh={refreshDash} />}
            {view === 'assess' && user.role === 'dosen' && <MentorView token={token} notify={notify} onAssess={goAssess} onExpire={expire} />}
            {view === 'assess' && user.role === 'perusahaan' && <AssessView token={token} target={assessTarget} notify={notify} onExpire={expire} onRefresh={refreshDash} />}
            {(assessTarget.project_id && view === 'assess' && user.role === 'dosen') && <AssessView token={token} target={assessTarget} notify={notify} onExpire={expire} onRefresh={refreshDash} />}
            {view === 'notifs' && <NotifsView token={token} notify={notify} onExpire={expire} />}
            {view === 'profile' && <ProfileView token={token} notify={notify} onExpire={expire} />}
          </main>
          <Toasts items={toasts} />
        </div>
      );
    }

    if (window.React && window.ReactDOM) {
      ReactDOM.createRoot(document.getElementById('app')).render(<App />);
    } else {
      document.getElementById('app').innerHTML =
        '<div class="min-h-screen flex items-center justify-center text-slate-200 px-6 text-center">' +
        'CDN tidak dapat dimuat (butuh internet).</div>';
    }
  </script>
</body>
</html>
