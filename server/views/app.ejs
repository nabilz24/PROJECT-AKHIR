    // ---- Halaman: Profil (semua role) ----
    function ProfileView(props) {
      const [data, setData] = useState(null);
      const [f, setF] = useState({});
      const [msg, setMsg] = useState('');
      const [isErr, setIsErr] = useState(false);
      async function load() {
        try {
          const j = await apiFetch('/users/profile', props.token);
          setData(j.data); setF(Object.assign({ name: j.data.user.name }, j.data.profile || {}));
        } catch (e) { if (e.code === 401) props.onExpire(); }
      }
      useEffect(() => { load(); }, []);
      function set(k, v) { setF(Object.assign({}, f, { [k]: v })); }
      async function save() {
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/users/profile', props.token, 'PUT', f);
          setMsg('Profil diupdate.'); load();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      if (!data) return <p className="text-sm text-slate-500">Memuat profil…</p>;
      const role = data.user.role;
      return (
        <div>
          <h2 className="text-xl font-bold text-white mb-3">Profil</h2>
          <Msg text={msg} err={isErr} />
          <Section title={data.user.name + ' · ' + role + ' · ' + data.user.email}>
            <label className="block text-xs text-slate-400 mb-1">Nama</label>
            <input value={f.name || ''} onChange={(e) => set('name', e.target.value)} className={INP} />
            {role === 'mahasiswa' && (
              <div>
                <div className="flex gap-2">
                  <input value={f.npm || ''} onChange={(e) => set('npm', e.target.value)} placeholder="NPM (8 karakter)" className={INP} />
                  <input value={f.angkatan || ''} onChange={(e) => set('angkatan', e.target.value)} placeholder="Angkatan" className={INP} />
                </div>
                <input value={f.program_studi || ''} onChange={(e) => set('program_studi', e.target.value)} placeholder="Program studi" className={INP} />
                <textarea value={f.bio || ''} onChange={(e) => set('bio', e.target.value)} placeholder="Bio" rows="2" className={INP}></textarea>
              </div>
            )}
            {role === 'perusahaan' && (
              <div>
                <input value={f.nama_perusahaan || ''} onChange={(e) => set('nama_perusahaan', e.target.value)} placeholder="Nama perusahaan" className={INP} />
                <div className="flex gap-2">
                  <input value={f.industri || ''} onChange={(e) => set('industri', e.target.value)} placeholder="Industri" className={INP} />
                  <select value={f.size || 'medium'} onChange={(e) => set('size', e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-2 mb-2 text-sm">
                    <option value="startup">startup</option><option value="medium">medium</option><option value="large">large</option><option value="corporate">corporate</option>
                  </select>
                </div>
                <textarea value={f.deskripsi || ''} onChange={(e) => set('deskripsi', e.target.value)} placeholder="Deskripsi" rows="2" className={INP}></textarea>
              </div>
            )}
            <button onClick={save} className={BTN}>Simpan</button>
          </Section>
        </div>
      );
    }

    const NAV = {
      mahasiswa: [['dash', 'Dashboard'], ['projects', 'Projects'], ['skills', 'My Skills'], ['gap', 'Gap Analysis'], ['recs', 'Recommendations'], ['notifs', 'Notifikasi'], ['profile', 'Profil']],
      perusahaan: [['dash', 'Dashboard'], ['myprojects', 'My Projects'], ['applications', 'Applications'], ['assess', 'Assess'], ['notifs', 'Notifikasi'], ['profile', 'Profil']],
      kampus: [['dash', 'Dashboard'], ['analytics', 'Analytics'], ['notifs', 'Notifikasi'], ['profile', 'Profil']],
      dosen: [['dash', 'Dashboard'], ['analytics', 'Analytics'], ['assess', 'Assess'], ['notifs', 'Notifikasi'], ['profile', 'Profil']],
    };
    const TITLES = {
      dash: null, analytics: 'Analytics', projects: 'Projects', skills: 'My Skills', gap: 'Gap Analysis',
      recs: 'Recommendations', myprojects: 'My Projects', applications: 'Applications', assess: 'Assess',
      notifs: 'Notifikasi', profile: 'Profil',
    };

    function App() {
      const [token, setToken] = useState(localStorage.getItem('token') || '');
      const [user, setUser] = useState(null);
      const [data, setData] = useState(null);
      const [view, setView] = useState('dash');
      const [assessTarget, setAssessTarget] = useState({});
      const [err, setErr] = useState('');
      const [loading, setLoading] = useState(false);

      function logout(expireMsg) {
        if (token) { fetch(API + '/auth/logout', { method: 'POST', headers: { Authorization: 'Bearer ' + token } }).catch(() => {}); }
        localStorage.removeItem('token');
        setToken(''); setUser(null); setData(null); setView('dash');
        if (expireMsg) setErr(expireMsg);
      }
      function endpointFor(role) {
        if (role === 'mahasiswa') return '/students/dashboard';
        if (role === 'perusahaan') return '/companies/dashboard';
        return '/campus/dashboard'; // kampus + dosen (RBAC route mengizinkan keduanya)
      }
      async function load(tk) {
        setLoading(true); setErr('');
        try {
          const me = await apiFetch('/auth/me', tk);
          const role = me.data.user.role;
          setUser(me.data.user);
          const dash = await apiFetch(endpointFor(role), tk);
          setData(dash.data);
        } catch (e) {
          if (e.code === 401) { logout('Sesi berakhir, silakan login ulang.'); }
          else setErr(e.message);
        } finally { setLoading(false); }
      }
      useEffect(() => { if (token) load(token); }, []);
      function onLogin(tk, usr) {
        localStorage.setItem('token', tk);
        setToken(tk); setUser(usr); setView('dash');
        load(tk);
      }
      function goAssess(t) { setAssessTarget(t || {}); setView('assess'); }

      if (!token || !user) return <LoginView onLogin={onLogin} />;
      const nav = NAV[user.role] || NAV.mahasiswa;
      const titles = { mahasiswa: 'Dashboard Mahasiswa', perusahaan: 'Dashboard Perusahaan', kampus: 'Dashboard Kampus', dosen: 'Dashboard Kampus (Dosen)' };
      const canAnalytics = user.role === 'kampus' || user.role === 'dosen';
      return (
        <div className="min-h-screen bg-slate-950 text-slate-200 flex">
          <aside className="w-52 shrink-0 bg-slate-900 border-r border-slate-800 p-4 flex flex-col">
            <p className="font-bold text-white text-sm mb-1">Talent Hub App</p>
            <p className="text-xs text-slate-500 mb-4">{user.name} · {user.role}</p>
            {nav.map((n) => (
              <button key={n[0]} onClick={() => setView(n[0])}
                className={'text-left text-sm rounded-lg px-3 py-2 mb-1 ' + (view === n[0] ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800')}>{n[1]}</button>
            ))}
            <div className="flex-1"></div>
            <a href="/" className="text-xs text-slate-500 hover:text-slate-300 px-3 py-1">← Landing</a>
            <button onClick={() => logout()} className="text-left text-sm text-red-400 hover:text-red-300 px-3 py-2">Keluar</button>
          </aside>
          <main className="flex-1 p-5 max-w-5xl">
            <h1 className="text-2xl font-extrabold text-white mb-4">{view === 'dash' ? (titles[user.role] || 'Dashboard') : (TITLES[view] || view)}</h1>
            {err && <p className="text-sm text-red-400 mb-3">{err}</p>}
            {loading && view === 'dash' && <p className="text-sm text-slate-500">Memuat data…</p>}
            {!loading && data && view === 'dash' && user.role === 'mahasiswa' && <StudentDash data={data} />}
            {!loading && data && view === 'dash' && user.role === 'perusahaan' && <CompanyDash data={data} />}
            {!loading && data && view === 'dash' && (user.role === 'kampus' || user.role === 'dosen') && <CampusDash data={data} />}
            {view === 'analytics' && canAnalytics && <AnalyticsView token={token} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {view === 'projects' && <ProjectsView token={token} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {view === 'skills' && <SkillsView token={token} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {view === 'gap' && <GapView token={token} user={user} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {view === 'recs' && <RecsView token={token} user={user} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {view === 'myprojects' && <MyProjectsView token={token} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {view === 'applications' && <ApplicationsView token={token} onAssess={goAssess} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {view === 'assess' && user.role === 'dosen' && <MentorView token={token} onAssess={goAssess} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {view === 'assess' && user.role === 'perusahaan' && <AssessView token={token} target={assessTarget} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {(assessTarget.project_id && view === 'assess' && user.role === 'dosen') && <AssessView token={token} target={assessTarget} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {view === 'notifs' && <NotifsView token={token} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
            {view === 'profile' && <ProfileView token={token} onExpire={() => logout('Sesi berakhir, silakan login ulang.')} />}
          </main>
        </div>
      );
    }

    if (window.React && window.ReactDOM) {
      ReactDOM.createRoot(document.getElementById('app')).render(<App />);
    } else {
      document.getElementById('app').innerHTML =
        '<div class="min-h-screen flex items-center justify-center text-slate-200 px-6 text-center">' +
        'CDN tidak dapat dimuat (butuh internet).</div>';
    }
  </script>
</body>
</html>
