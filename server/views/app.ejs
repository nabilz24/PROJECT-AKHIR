<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Campus Industry Talent Hub</title>
  <!-- TASK-109: semua halaman dashboard di SPA /app (React 18 UMD + Tailwind v4 browser CDN).
       Halaman: Dashboard, Projects, My Skills, Gap, Recommendations, My Projects,
       Applications, Assess, Analytics, Notifikasi, Profil. EJS /dashboard/* tetap ada. -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script crossorigin src="https://unpkg.com/react@18.2.0/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18.2.0/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone@7.23.5/babel.min.js"></script>
</head>
<body class="bg-slate-950">
  <div id="app"><div class="min-h-screen flex items-center justify-center text-slate-400">Memuat dashboard…</div></div>
  <noscript><div class="min-h-screen flex items-center justify-center text-slate-200">Aktifkan JavaScript.</div></noscript>
  <script type="text/babel" data-presets="react">
    const { useState, useEffect } = React;
    const API = '/api/v1';
    const INP = 'w-full rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-2 mb-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500';
    const BTN = 'rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold px-3 py-1.5';
    const BTN2 = 'rounded-lg border border-slate-600 hover:border-slate-400 text-slate-200 text-sm px-3 py-1.5';
    const DANGER = 'rounded-lg border border-red-700 hover:bg-red-900 text-red-300 text-sm px-3 py-1.5';

    async function apiFetch(path, token) {
      const r = await fetch(API + path, { headers: { Authorization: 'Bearer ' + token } });
      if (r.status === 401) { const e = new Error('Sesi berakhir, silakan login ulang.'); e.code = 401; throw e; }
      return r.json();
    }
    async function apiSend(path, token, method, body) {
      const r = await fetch(API + path, {
        method, headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify(body || {}),
      });
      if (r.status === 401) { const e = new Error('Sesi berakhir, silakan login ulang.'); e.code = 401; throw e; }
      let j = {};
      try { j = await r.json(); } catch (ex) { j = { success: false, message: 'Respons tak terduga (' + r.status + ')' }; }
      if (!j.success) { const e = new Error(j.message || ('Gagal (' + r.status + ')')); e.code = r.status; throw e; }
      return j;
    }

    function matchColor(s) {
      if (s == null) return 'bg-slate-700 text-slate-200';
      if (s >= 70) return 'bg-green-600 text-white';
      if (s >= 40) return 'bg-yellow-500 text-slate-900';
      return 'bg-red-600 text-white';
    }
    function gapColor(c) {
      if (c === 'critical') return 'bg-red-600 text-white';
      if (c === 'large') return 'bg-orange-500 text-slate-900';
      if (c === 'medium') return 'bg-yellow-500 text-slate-900';
      if (c === 'small') return 'bg-emerald-600 text-white';
      return 'bg-slate-700 text-slate-200';
    }

    function StatCard(props) {
      return (
        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5">
          <p className="text-xs uppercase tracking-wide text-slate-500">{props.label}</p>
          <p className="text-3xl font-extrabold text-white mt-1">{props.value}</p>
          {props.sub && <p className="text-xs text-slate-500 mt-1">{props.sub}</p>}
        </div>
      );
    }
    function Section(props) {
      return (
        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 mt-4">
          <h3 className="font-bold text-white mb-3">{props.title}</h3>
          {props.children}
        </div>
      );
    }
    function Bar(props) {
      const pct = Math.min(100, Math.max(0, (props.value / (props.max || 100)) * 100));
      return (
        <div className="flex items-center gap-2 py-1">
          <span className="w-36 truncate text-sm text-slate-300">{props.label}</span>
          <div className="flex-1 h-2.5 rounded bg-slate-800 overflow-hidden">
            <div className={'h-full rounded ' + (props.color || 'bg-indigo-500')} style={{ width: pct + '%' }}></div>
          </div>
          <span className="w-16 text-right text-sm text-slate-400">{props.value}</span>
        </div>
      );
    }
    function Msg(props) {
      if (!props.text) return null;
      return <p className={'text-sm mb-3 ' + (props.err ? 'text-red-400' : 'text-emerald-400')}>{props.text}</p>;
    }

    function LoginView(props) {
      const [email, setEmail] = useState('');
      const [password, setPassword] = useState('');
      const [err, setErr] = useState('');
      const [loading, setLoading] = useState(false);
      async function submit(e) {
        e.preventDefault(); setErr(''); setLoading(true);
        try {
          const r = await fetch(API + '/auth/login', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });
          const j = await r.json();
          if (!j.success) { setErr(j.message || 'Login gagal'); return; }
          props.onLogin(j.data.token, j.data.user);
        } catch (ex) { setErr('Tidak dapat menghubungi server.'); }
        finally { setLoading(false); }
      }
      return (
        <div className="min-h-screen flex items-center justify-center px-4">
          <form onSubmit={submit} className="w-full max-w-sm bg-slate-900 border border-slate-800 rounded-2xl p-8">
            <h1 className="font-bold text-white text-lg">Dashboard App</h1>
            <p className="text-sm text-slate-400 mb-5">Login untuk melihat dashboard sesuai role.</p>
            <label className="block text-sm text-slate-300 mb-1">Email</label>
            <input type="email" required value={email} onChange={(e) => setEmail(e.target.value)} className={INP} />
            <label className="block text-sm text-slate-300 mb-1">Password</label>
            <input type="password" required value={password} onChange={(e) => setPassword(e.target.value)} className={INP} />
            {err && <p className="text-sm text-red-400 mb-3">{err}</p>}
            <button disabled={loading} className="w-full rounded-lg bg-indigo-600 hover:bg-indigo-500 disabled:opacity-60 text-white font-semibold py-2">
              {loading ? 'Memproses…' : 'Login'}
            </button>
            <p className="text-xs text-slate-500 mt-3"><a className="underline" href="/">← Kembali ke landing</a></p>
          </form>
        </div>
      );
    }

    function StudentDash(props) {
      const d = props.data;
      return (
        <div>
          <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
            <StatCard label="Skill" value={d.skills_count} />
            <StatCard label="Aplikasi Pending" value={d.pending_applications.length} />
            <StatCard label="Notif Belum Dibaca" value={d.unread_notifications} />
            <StatCard label="Project Baru" value={d.new_projects.length} />
          </div>
          <Section title="Project Baru + Match Score">
            {d.new_projects.length === 0 && <p className="text-sm text-slate-500">Belum ada project aktif.</p>}
            {d.new_projects.map((p) => (
              <div key={p.id} className="flex items-center gap-3 py-2 border-b border-slate-800 last:border-0">
                <span className="flex-1 text-sm text-slate-200">{p.judul} <span className="text-slate-500">· {p.sektor_industri || ''}</span></span>
                <span className={'text-xs font-bold px-2 py-1 rounded ' + matchColor(p.match_score)}>{p.match_score}</span>
              </div>
            ))}
          </Section>
          <Section title="Top Rekomendasi">
            {d.top_recommendations.map((r) => (
              <div key={r.id} className="py-2 border-b border-slate-800 last:border-0">
                <p className="text-sm text-slate-200">{r.title} <span className="text-xs text-indigo-400">[{r.priority}]</span></p>
                <p className="text-xs text-slate-500">{r.description || ''}</p>
              </div>
            ))}
          </Section>
          <Section title="Aplikasi Pending">
            {d.pending_applications.length === 0 && <p className="text-sm text-slate-500">Tidak ada aplikasi pending.</p>}
            {d.pending_applications.map((a) => (
              <div key={a.id} className="flex items-center gap-3 py-2 border-b border-slate-800 last:border-0">
                <span className="flex-1 text-sm text-slate-200">{a.project_judul}</span>
                <span className={'text-xs font-bold px-2 py-1 rounded ' + matchColor(a.match_score)}>{a.match_score == null ? '–' : a.match_score}</span>
              </div>
            ))}
          </Section>
          <Section title="Notifikasi Terbaru">
            {d.latest_notifications.map((n) => (
              <p key={n.id} className="text-sm text-slate-300 py-1 border-b border-slate-800 last:border-0">
                <span className="text-indigo-400">[{n.type}]</span> {n.content}
              </p>
            ))}
          </Section>
        </div>
      );
    }

    function CompanyDash(props) {
      const d = props.data;
      return (
        <div>
          <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
            <StatCard label="Project Aktif" value={d.active_projects_count} />
            <StatCard label="Kandidat Menunggu" value={d.waiting_candidates_count} />
            <StatCard label="Evaluasi Menunggu" value={d.pending_evaluations_count} />
            <StatCard label="Rata-rata Match" value={d.avg_match_score == null ? '–' : d.avg_match_score} />
          </div>
          <Section title="Project Aktif">
            {d.active_projects.map((p) => (
              <p key={p.id} className="text-sm text-slate-200 py-1 border-b border-slate-800 last:border-0">
                {p.judul} <span className="text-slate-500">· deadline {p.deadline || '–'} · {p.difficulty || ''}</span>
              </p>
            ))}
          </Section>
          <Section title="Kandidat Menunggu">
            {d.waiting_candidates.length === 0 && <p className="text-sm text-slate-500">Tidak ada kandidat menunggu.</p>}
            {d.waiting_candidates.map((c) => (
              <div key={c.application_id} className="flex items-center gap-3 py-2 border-b border-slate-800 last:border-0">
                <span className="flex-1 text-sm text-slate-200">{c.student_name} <span className="text-slate-500">· {c.project_judul}</span></span>
                <span className={'text-xs font-bold px-2 py-1 rounded ' + matchColor(c.match_score)}>{c.match_score == null ? '–' : c.match_score}</span>
              </div>
            ))}
          </Section>
          <Section title="Evaluasi Menunggu">
            {d.pending_evaluations.length === 0 && <p className="text-sm text-slate-500">Tidak ada evaluasi menunggu.</p>}
            {d.pending_evaluations.map((e) => (
              <p key={e.application_id} className="text-sm text-slate-200 py-1 border-b border-slate-800 last:border-0">
                {e.student_name} <span className="text-slate-500">· {e.project_judul}</span>
              </p>
            ))}
          </Section>
        </div>
      );
    }

    function CampusDash(props) {
      const d = props.data;
      const maxTop = Math.max.apply(null, [1].concat(d.top_demanded_skills.map((s) => s.c)));
      return (
        <div>
          <div className="grid grid-cols-2 md:grid-cols-5 gap-3">
            <StatCard label="Mahasiswa" value={d.total_students} />
            <StatCard label="Perusahaan" value={d.total_companies} />
            <StatCard label="Project Aktif" value={d.total_active_projects} />
            <StatCard label="Aplikasi Pending" value={d.pending_applications} />
            <StatCard label="Rata-rata Gap" value={d.avg_gap} />
          </div>
          <Section title="Top Skill Dicari Industri">
            {d.top_demanded_skills.map((s) => <Bar key={s.name} label={s.name} value={s.c} max={maxTop} />)}
          </Section>
          <Section title="Skill Baru 30 Hari (Alert)">
            {d.new_skills_30d.length === 0 && <p className="text-sm text-slate-500">Tidak ada skill baru.</p>}
            <div className="flex flex-wrap gap-2">
              {d.new_skills_30d.map((s) => <span key={s} className="text-xs bg-indigo-900 text-indigo-200 px-2 py-1 rounded">{s}</span>)}
            </div>
          </Section>
          <Section title="Aplikasi Terbaru">
            {d.recent_applications.map((a, i) => (
              <p key={i} className="text-sm text-slate-200 py-1 border-b border-slate-800 last:border-0">
                {a.student_name} <span className="text-slate-500">→ {a.project_judul} [{a.status}]</span>
              </p>
            ))}
          </Section>
        </div>
      );
    }

    function AnalyticsView(props) {
      const [pie, setPie] = useState(null);
      const [line, setLine] = useState(null);
      const [heat, setHeat] = useState(null);
      const [err, setErr] = useState('');
      useEffect(() => {
        let alive = true;
        Promise.all([
          apiFetch('/analytics/skill-distribution', props.token),
          apiFetch('/analytics/industry-demand', props.token),
          apiFetch('/analytics/gap-heatmap', props.token),
        ]).then((arr) => { if (alive) { setPie(arr[0].data); setLine(arr[1].data); setHeat(arr[2].data); } })
          .catch((e) => { if (alive) { if (e.code === 401) props.onExpire(); else setErr(e.message); } });
        return () => { alive = false; };
      }, []);
      async function downloadCsv() {
        try {
          const r = await fetch(API + '/analytics/export?format=csv', { headers: { Authorization: 'Bearer ' + props.token } });
          if (r.status === 401) { props.onExpire(); return; }
          const blob = await r.blob();
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob); a.download = 'gap-export.csv'; a.click();
        } catch (ex) { setErr('Gagal mengunduh CSV.'); }
      }
      if (err) return <p className="text-sm text-red-400">{err}</p>;
      if (!pie || !line || !heat) return <p className="text-sm text-slate-500">Memuat analytics…</p>;
      const maxDist = Math.max.apply(null, [1].concat(pie.distribution.map((s) => s.students)));
      const maxTop = Math.max.apply(null, [1].concat(line.top_skills.map((s) => s.c)));
      return (
        <div>
          <div className="flex items-center justify-between">
            <h2 className="text-xl font-bold text-white">Analytics</h2>
            <button onClick={downloadCsv} className={BTN}>Export CSV</button>
          </div>
          <Section title={'Distribusi Skill (' + pie.total_students + ' mahasiswa)'}>
            {pie.distribution.slice(0, 12).map((s) => (
              <Bar key={s.name} label={s.name + ' (' + s.avg_level + ')'} value={s.students} max={maxDist} />
            ))}
          </Section>
          <Section title="Tren Skill Dicari Industri">
            {line.top_skills.map((s) => <Bar key={s.skill} label={s.skill} value={s.c} max={maxTop} color="bg-emerald-500" />)}
          </Section>
          <Section title="Heatmap Gap per Prodi">
            <div className="overflow-x-auto">
              <table className="text-xs text-slate-300 border-collapse">
                <thead><tr><th className="p-1.5 text-left">Prodi</th>
                  {heat.skills.map((s) => <th key={s} className="p-1.5 text-left font-normal">{s}</th>)}
                </tr></thead>
                <tbody>
                  {heat.matrix.map((row) => (
                    <tr key={row.program_studi} className="border-t border-slate-800">
                      <td className="p-1.5 font-semibold">{row.program_studi}</td>
                      {heat.skills.map((s) => {
                        const v = row.gaps[s] || 0;
                        const a = Math.min(0.85, v / 60);
                        return <td key={s} className="p-1.5 text-center" style={{ background: 'rgba(239,68,68,' + a + ')' }}>{v}</td>;
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </Section>
        </div>
      );
    }

    // ---- Halaman: Projects (mahasiswa) ----
    function ProjectsView(props) {
      const [list, setList] = useState([]);
      const [sektor, setSektor] = useState('');
      const [diff, setDiff] = useState('');
      const [sort, setSort] = useState('terbaru');
      const [detail, setDetail] = useState(null);
      const [cover, setCover] = useState('');
      const [msg, setMsg] = useState('');
      const [isErr, setIsErr] = useState(false);
      async function browse() {
        setMsg(''); setIsErr(false);
        try {
          const q = [];
          if (sektor) q.push('filter[sektor_industri]=' + encodeURIComponent(sektor));
          if (diff) q.push('filter[difficulty]=' + diff);
          q.push('filter[status]=active');
          q.push('sort=' + sort);
          const j = await apiFetch('/projects?' + q.join('&'), props.token);
          setList(j.data.projects || []);
          setDetail(null);
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      useEffect(() => { browse(); }, []);
      async function openDetail(id) {
        try {
          const j = await apiFetch('/projects/' + id, props.token);
          setDetail(j.data.project); setCover(''); setMsg(''); setIsErr(false);
        } catch (e) { if (e.code === 401) props.onExpire(); }
      }
      async function apply(id) {
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/projects/' + id + '/apply', props.token, 'POST', { cover_letter: cover || undefined });
          setMsg('Aplikasi terkirim.');
          browse();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      return (
        <div>
          <h2 className="text-xl font-bold text-white mb-3">Projects</h2>
          <div className="flex flex-wrap gap-2 mb-3">
            <input value={sektor} onChange={(e) => setSektor(e.target.value)} placeholder="Sektor…" className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm" />
            <select value={diff} onChange={(e) => setDiff(e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
              <option value="">Semua difficulty</option><option value="easy">Easy</option><option value="medium">Medium</option><option value="hard">Hard</option>
            </select>
            <select value={sort} onChange={(e) => setSort(e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
              <option value="terbaru">Terbaru</option><option value="deadline">Deadline</option><option value="match_score">Match score</option>
            </select>
            <button onClick={browse} className={BTN}>Cari</button>
          </div>
          <Msg text={msg} err={isErr} />
          {list.map((p) => (
            <div key={p.id} className="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-2 flex items-center gap-3">
              <span className="flex-1 text-sm text-slate-200">{p.judul} <span className="text-slate-500">· {p.sektor_industri || '–'} · {p.difficulty || '–'} · {p.deadline || '–'}</span></span>
              {p.match_score != null && <span className={'text-xs font-bold px-2 py-1 rounded ' + matchColor(p.match_score)}>{p.match_score}</span>}
              <button onClick={() => openDetail(p.id)} className={BTN2}>Detail</button>
            </div>
          ))}
          {list.length === 0 && <p className="text-sm text-slate-500">Tidak ada project.</p>}
          {detail && (
            <Section title={'Detail: ' + detail.judul}>
              <p className="text-sm text-slate-300 mb-2">{detail.deskripsi || '(tanpa deskripsi)'}</p>
              <p className="text-xs text-slate-500 mb-2">Sektor: {detail.sektor_industri || '–'} · Deadline: {detail.deadline || '–'} · Status: {detail.status}</p>
              <div className="flex flex-wrap gap-2 mb-3">
                {(detail.skills || []).map((s) => (
                  <span key={s.skill_id || s.id} className="text-xs bg-slate-800 text-slate-200 px-2 py-1 rounded">{s.name || ('Skill #' + (s.skill_id || s.id))} ≥ {s.level_required}</span>
                ))}
              </div>
              <textarea value={cover} onChange={(e) => setCover(e.target.value)} placeholder="Cover letter (opsional)" rows="2" className={INP}></textarea>
              <button onClick={() => apply(detail.id)} className={BTN}>Daftar Project Ini</button>
            </Section>
          )}
        </div>
      );
    }

    // ---- Halaman: My Skills (mahasiswa) ----
    function SkillsView(props) {
      const [mine, setMine] = useState([]);
      const [tax, setTax] = useState([]);
      const [sid, setSid] = useState('');
      const [level, setLevel] = useState(50);
      const [source, setSource] = useState('course');
      const [editId, setEditId] = useState(null);
      const [editLevel, setEditLevel] = useState(50);
      const [msg, setMsg] = useState('');
      const [isErr, setIsErr] = useState(false);
      async function load() {
        try {
          const a = await apiFetch('/students/skills', props.token);
          setMine(a.data.skills || []);
          const b = await apiFetch('/skills', props.token);
          setTax(b.data.skills || []);
          if (!sid && (b.data.skills || []).length > 0) setSid(String(b.data.skills[0].id));
        } catch (e) { if (e.code === 401) props.onExpire(); }
      }
      useEffect(() => { load(); }, []);
      async function add() {
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/students/skills', props.token, 'POST', { skill_id: Number(sid), proficiency_level: Number(level), source });
          setMsg('Skill ditambahkan.'); load();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      async function save(id) {
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/students/skills/' + id, props.token, 'PUT', { proficiency_level: Number(editLevel) });
          setEditId(null); setMsg('Skill diupdate.'); load();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      async function del(id) {
        if (!window.confirm('Hapus skill ini?')) return;
        setMsg(''); setIsErr(false);
        try {
          await apiSend('/students/skills/' + id, props.token, 'DELETE');
          setMsg('Skill dihapus.'); load();
        } catch (e) { if (e.code === 401) props.onExpire(); else { setMsg(e.message); setIsErr(true); } }
      }
      return (
        <div>
          <h2 className="text-xl font-bold text-white mb-3">My Skills</h2>
          <Msg text={msg} err={isErr} />
          <Section title="Tambah Skill">
            <div className="flex flex-wrap gap-2">
              <select value={sid} onChange={(e) => setSid(e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
                {tax.map((s) => <option key={s.id} value={s.id}>{s.name} [{s.category}]</option>)}
              </select>
              <input type="number" min="0" max="100" value={level} onChange={(e) => setLevel(e.target.value)} className="w-20 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm" />
              <select value={source} onChange={(e) => setSource(e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
                <option value="course">course</option><option value="certification">certification</option><option value="experience">experience</option>
              </select>
              <button onClick={add} className={BTN}>Tambah</button>
            </div>
          </Section>
          <Section title={'Skill Saya (' + mine.length + ')'}>
            {mine.map((s) => (
              <div key={s.skill_id} className="py-2 border-b border-slate-800 last:border-0">
                <div className="flex items-center gap-2">
                  <span className="flex-1 text-sm text-slate-200">{s.name} <span className="text-slate-500">[{s.proficiency_category} · {s.source}]</span></span>
                  <span className="text-sm text-slate-300 w-10 text-right">{s.proficiency_level}</span>
                  <button onClick={() => { setEditId(s.skill_id); setEditLevel(s.proficiency_level); }} className={BTN2}>Edit</button>
                  <button onClick={() => del(s.skill_id)} className={DANGER}>Hapus</button>
                </div>
                {editId === s.skill_id && (
                  <div className="flex gap-2 mt-2">
                    <input type="number" min="0" max="100" value={editLevel} onChange={(e) => setEditLevel(e.target.value)} className="w-20 rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm" />
                    <button onClick={() => save(s.skill_id)} className={BTN}>Simpan</button>
                    <button onClick={() => setEditId(null)} className={BTN2}>Batal</button>
                  </div>
                )}
              </div>
            ))}
          </Section>
        </div>
      );
    }

    // ---- Halaman: Gap Analysis (mahasiswa) ----
    function GapView(props) {
      const [projects, setProjects] = useState([]);
      const [pid, setPid] = useState('');
      const [result, setResult] = useState(null);
      const [msg, setMsg] = useState('');
      useEffect(() => {
        apiFetch('/projects?filter[status]=active&sort=terbaru', props.token)
          .then((j) => {
            const arr = j.data.projects || [];
            setProjects(arr);
            if (arr.length > 0) setPid(String(arr[0].id));
          })
          .catch((e) => { if (e.code === 401) props.onExpire(); });
      }, []);
      async function run() {
        setMsg('');
        try {
          const j = await apiFetch('/gap-analysis/' + props.user.id + '/' + pid, props.token);
          setResult(j.data);
        } catch (e) { if (e.code === 401) props.onExpire(); else setMsg(e.message); }
      }
      return (
        <div>
          <h2 className="text-xl font-bold text-white mb-3">Gap Analysis</h2>
          <div className="flex gap-2 mb-3">
            <select value={pid} onChange={(e) => setPid(e.target.value)} className="rounded-lg bg-slate-800 border border-slate-700 text-slate-100 px-3 py-1.5 text-sm">
              {projects.map((p) => <option key={p.id} value={p.id}>{p.judul}</option>)}
            </select>
            <button onClick={run} className={BTN}>Analisis</button>
          </div>
          {msg && <p className="text-sm text-red-400 mb-3">{msg}</p>}
          {result && (
            <Section title="Hasil Analisis">
              <div className="overflow-x-auto">
                <table className="text-sm text-slate-200 w-full">
                  <thead><tr className="text-left text-slate-500 text-xs">
                    <th className="py-1">Skill</th><th className="py-1">Butuh</th><th className="py-1">Saya</th><th className="py-1">Gap</th><th className="py-1">Klasifikasi</th>
                  </tr></thead>
                  <tbody>
                    {(result.gaps || []).map((g) => (
                      <tr key={g.skill_id} className="border-t border-slate-800">
                        <td className="py-1.5">{g.name}</td><td>{g.required}</td><td>{g.current}</td>
                        <td className="font-bold">{g.gap_value}</td>
                        <td><span className={'text-xs font-bold px-2 py-0.5 rounded ' + gapColor(g.classification)}>{g.classification}</span></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {result.summary && <p className="text-xs text-slate-500 mt-2">Ringkasan: {JSON.stringify(result.summary)}</p>}
            </Section>
          )}
        </div>
      );
    }

    // ---- Halaman: Recommendations (mahasiswa) ----
    function RecsView(props) {
      const [list, setList] = useState([]);
      async function load() {
        try {
          const j = await apiFetch('/recommendations/student/' + props.user.id, props.token);
          setList(j.data.recommendations || []);
        } catch (e) { if (e.code === 401) props.onExpire(); }
      }
      useEffect(() => { load(); }, []);
      async function act(id, action) {
        try {
          await apiSend('/recommendations/' + id + '/action', props.token, 'POST', { action });
          load();
        } catch (e) { if (e.code === 401) props.onExpire(); }
      }
      return (
        <div>
          <h2 className="text-xl font-bold text-white mb-3">Recommendations</h2>
          {list.length === 0 && <p className="text-sm text-slate-500">Belum ada rekomendasi. Jalankan Gap Analysis dulu.</p>}
