            <div key={r.id} className="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-2">
              <p className="text-sm text-slate-200 font-semibold">{r.title} <span className="text-xs text-indigo-400">[{r.priority} · {r.status}]</span></p>
              <p className="text-xs text-slate-500 mb-2">{r.description || ''}</p>
              <div className="flex gap-2">
                {r.status === 'pending' && <button onClick={() => act(r.id, 'start')} className={BTN}>Mulai</button>}
