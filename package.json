{
  "name": "campus-industry-talent-hub",
  "version": "1.0.0",
  "description": "Campus Industry Talent Hub — Platform menghubungkan industri dengan mahasiswa kampus melalui project marketplace dan talent intelligence",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "node --watch server/src/server.js",
    "start": "node server/src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "node server/src/db/migrate.js",
    "db:seed": "node server/src/db/seed.js",
    "db:seed:test": "node server/src/db/seed.js --test-accounts",
    "lint": "echo \"Lint not configured yet (Phase 11)\" && exit 0"
  },
  "keywords": [
    "campus",
    "industry",
    "talent",
    "matching",
    "skill-gap",
    "project-marketplace"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "ecc-universal": "^2.2.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "impeccable": "^3.6.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "session": "^0.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "server/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}
